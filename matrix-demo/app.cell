// Uses the `matrix` package installed via `soma install`.
use matrix

cell Demo {
    face { signal run() -> Map }
    on run() {
        let A = [4, 7, 2, 6].reshape(2, 2)
        let Ainv = inverse(A)              // from the package
        let check = A * Ainv               // ≈ identity (builtin operator)
        let x = solve([2, 1, 1, 3].reshape(2, 2), list(3.0, 5.0))
        let n = norm(list(3.0, 4.0))       // package
        print("A          = {A}")
        print("inverse(A) = {Ainv}")
        print("A * A^-1   = {check}   (≈ I)")
        print("solve       = {x}")
        print("norm(3,4)   = {n}")
        return map("solve", x, "norm", n)
    }
}
