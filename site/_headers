# Cloudflare Pages headers. Machine-readable files are readable from
# anywhere (browser-based agents included) and declare what they are.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/agent.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/docs/*
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/skill/*
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/corpus/*.cell
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/corpus/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/corpus/index.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/examples/*.cell
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/builtins.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/gotchas.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/version.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60

/repo/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60

/.well-known/*
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/LICENSE
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/CHANGELOG.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-service.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
