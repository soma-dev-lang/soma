// Doublures PROVISOIRES des façades que les corps d'escalade appellent — pour test_escalade
// seulement (l'intégrateur assemble les vrais corps dans prod.cell). Sans état : tout se lit dans les ids.
//
// Monde de test (H0 = 1 000 000 000 000 ms) :
// - personnes d'ORBITE : "analyste…", "sup…", "dir…", "conf…", "aud…", "expl…" ; d'opérateur :
//   "dyn-<org>", "cdm-<org>", "adm-<org>" (alpha, beta, vide) ; d'État : "pf-<fr|de|it|susp>"
//   (point_focal), "aut-<…>" (autorite), qui agissent pour "ORG-ETAT-<FR|DE|IT|SUSP>" ;
//   "intrus…" n'a aucun rôle ; quatre_yeux(a, b) faux si a == b ou si b n'est pas superviseur,
//   conformite ou direction.
// - organisations : ORG-ALPHA (État FR), ORG-BETA (DE), ORG-VIDE (IT, aucun contact), ORG-SUSPE
//   (État SUSP, non participant) ; "ORG-INCONNU…" est inconnue d'operateurs.
// - rapprochement "CJ-<s>" : objets ["OBJ-A-<s>", "OBJ-B-<s>"] (ORG-ALPHA, ORG-BETA) ; "CJ-<s>~<a>~<b>" : a et b.
//   Marqueurs : INCONNU, SUIVI, RESOLU, COORD (en_coordination) pour ApiConjonctions.etat (sinon alerte) ;
//   TARD (TCA à H0 + 3 h), PROCHE (H0 + 30 h), sinon H0 + 10 j ; SANSCO (coordination jamais ouverte),
//   DECIDE (coordination a statué), REPONDU (aucun muet), MUET2 (ALPHA et BETA muets ; sinon BETA seul) ;
//   SECRET (ORG-BETA ne reçoit pas les données) ; ACQ (messages acquittés), ECHEC (messages échoués),
//   NOTIFKO (la passerelle refuse).
// - objets : "OBJ-B…" à ORG-BETA, contenant "VIDE" à ORG-VIDE, "SUSPE" à ORG-SUSPE, "DEB" sans propriétaire,
//   sinon ORG-ALPHA ; "OBJ-MORT…" ne manœuvre pas ; "FAIB" propulsion faible (préavis 72 h).
// - ApiConjonctions.urgents renvoie ["CJ-URG"] seulement si h % 1000 == 7.

flesh ApiAcces {
    on a_le_role(personne, r) {
        if personne == "systeme" { return r == "systeme" }
        let role_p = _role(personne)
        return role_p != "aucun" && role_p == to_string(r)
    }
    on agit_pour(personne, org) {
        let e = _org(personne)
        return e != "" && e == to_string(org) && _role(personne) != "aucun"
    }
    on employeur(personne) {
        let e = _org(personne)
        require e != "" else Inconnu "personne inconnue : {personne}"
        return Org(e)
    }
    on quatre_yeux(demandeur, valideur) {
        let rv = _role(valideur)
        return demandeur != valideur && _role(demandeur) != "aucun" && (rv == "superviseur" || rv == "conformite" || rv == "direction")
    }
    on _org(p: String) {
        let role_p = _role(p)
        if role_p == "analyste" || role_p == "superviseur" || role_p == "direction" || role_p == "conformite" || role_p == "auditeur" || role_p == "exploitant" { return "ORG-ORBITE" }
        if role_p == "point_focal" || role_p == "autorite" {
            let suffixe = split(p, "-")[1]
            if suffixe == "fr" { return "ORG-ETAT-FR" }
            if suffixe == "de" { return "ORG-ETAT-DE" }
            if suffixe == "it" { return "ORG-ETAT-IT" }
            return "ORG-ETAT-SUSP"
        }
        if ends_with(p, "-alpha") { return "ORG-ALPHA" }
        if ends_with(p, "-beta") { return "ORG-BETA" }
        if ends_with(p, "-vide") { return "ORG-VIDE" }
        return ""
    }
    on _role(p: String) {
        if starts_with(p, "intrus") { return "aucun" }
        if starts_with(p, "analyste") { return "analyste" }
        if starts_with(p, "sup") { return "superviseur" }
        if starts_with(p, "dir") { return "direction" }
        if starts_with(p, "conf") { return "conformite" }
        if starts_with(p, "aud") { return "auditeur" }
        if starts_with(p, "expl") { return "exploitant" }
        if starts_with(p, "dyn-") { return "dynamicien" }
        if starts_with(p, "cdm-") { return "chef_de_mission" }
        if starts_with(p, "adm-") { return "administrateur_operateur" }
        if starts_with(p, "pf-") { return "point_focal" }
        if starts_with(p, "aut-") { return "autorite" }
        return "aucun"
    }
}

flesh ApiRef {
    on orbite() {
        return "ORG-ORBITE"
    }
    on etat_participant(etat) {
        return !contains(etat, "SUSP")
    }
    on etat_de(org) {
        require !starts_with(org, "ORG-INCONNU") else Inconnu "organisation inconnue : {org}"
        if org == "ORG-ALPHA" { return "FR" }
        if org == "ORG-BETA" { return "DE" }
        if org == "ORG-VIDE" { return "IT" }
        return "SUSP"
    }
    on org_de_etat(etat) {
        return "ORG-ETAT-{etat}"
    }
    on proprietaire(objet) {
        if contains(objet, "DEB") { return "inconnu" }
        if contains(objet, "VIDE") { return "ORG-VIDE" }
        if contains(objet, "SUSPE") { return "ORG-SUSPE" }
        if starts_with(objet, "OBJ-B") { return "ORG-BETA" }
        return "ORG-ALPHA"
    }
    on propulsion(objet) {
        if starts_with(objet, "OBJ-MORT") || contains(objet, "DEB") { return "aucune" }
        if contains(objet, "FAIB") { return "faible" }
        return "impulsionnelle"
    }
    on peut_manoeuvrer(objet) {
        return !starts_with(objet, "OBJ-MORT") && !contains(objet, "DEB")
    }
}

flesh ApiConjonctions {
    on etat(r) {
        if contains(r, "INCONNU") { return "inconnu" }
        if contains(r, "SUIVI") { return "suivi" }
        if contains(r, "RESOLU") { return "resolu" }
        if contains(r, "COORD") { return "en_coordination" }
        return "alerte"
    }
    on objets(r) {
        require !contains(r, "INCONNU") else Inconnu "rapprochement inconnu : {r}"
        if contains(r, "~") {
            let morceaux = split(r, "~")
            return [morceaux[1], morceaux[2]]
        }
        let s = substring(r, 3, len(r))
        return ["OBJ-A-{s}", "OBJ-B-{s}"]
    }
    on tca(r) {
        require !contains(r, "INCONNU") else Inconnu "rapprochement inconnu : {r}"
        if contains(r, "TARD") { return 1000010800000 }
        if contains(r, "PROCHE") { return 1000108000000 }
        return 1000864000000
    }
    on urgents(h, horizon, niveau_min) {
        if to_int(h) % 1000 == 7 { return ["CJ-URG"] }
        return []
    }
}

flesh ApiCoordination {
    on etat(r) {
        if contains(r, "SANSCO") { return "inconnue" }
        if contains(r, "DECIDE") { return "arretee" }
        return "proposee"
    }
    on decidee(r) {
        return contains(r, "DECIDE")
    }
    on muets(r) {
        require !contains(r, "SANSCO") else Inconnu "aucune coordination pour {r}"
        if contains(r, "REPONDU") || contains(r, "DECIDE") { return [] }
        if contains(r, "MUET2") { return ["ORG-ALPHA", "ORG-BETA"] }
        return ["ORG-BETA"]
    }
}

flesh ApiOperateurs {
    on statut(op) {
        if starts_with(op, "ORG-INCONNU") { return "inconnu" }
        return "actif"
    }
    on delai_reponse(op, n) {
        require !starts_with(op, "ORG-INCONNU") else Inconnu "opérateur inconnu : {op}"
        if n == 3 { return 3600000 }
        return 14400000
    }
    on contacts(op, echelon, h) {
        require !starts_with(op, "ORG-INCONNU") else Inconnu "opérateur inconnu : {op}"
        require echelon >= 1 && echelon <= 3 else HorsBornes "échelon {echelon}"
        if op == "ORG-VIDE" { return [] }
        let suffixe = lowercase(substring(op, 4, len(op)))
        if echelon == 1 { return ["dyn-{suffixe}"] }
        if echelon == 2 { return ["cdm-{suffixe}"] }
        if op == "ORG-ALPHA" { return ["pf-fr"] }
        if op == "ORG-BETA" { return ["pf-de"] }
        return ["pf-susp"]
    }
}

flesh ApiPriorites {
    on preavis(p) {
        if p == "impulsionnelle" { return 3600000 }
        if p == "faible" { return 259200000 }
        return 0
    }
}

flesh ApiConformite {
    on constater(h, op, nature, gravite, reference, par) {
        return "MQ-{nature}-{reference}"
    }
}

flesh ApiDonnees {
    on peut_recevoir(org, objet, r, h) {
        return !(contains(r, "SECRET") && org == "ORG-BETA")
    }
    on tracer(h, org, objet, r, nature) {
        return 1
    }
}

flesh ApiPasserelle {
    on notifier(h, destinataire, r, sujet, texte, urgence) {
        require !contains(r, "NOTIFKO") else Plein "passerelle saturée"
        return "MSG-{destinataire}-{r}-{h}"
    }
    on acquitte(message) {
        return contains(message, "ACQ")
    }
    on echoue(message) {
        return contains(message, "ECHEC")
    }
}

flesh ApiResponsabilite {
    on geler(h, evenement, motif, par) {
        return "GEL-{evenement}"
    }
    on sous_gel(cible) {
        return contains(cible, "GEL")
    }
}

flesh ApiOperations {
    on declarer_incident(h, incident, gravite, sous_systeme, description, par) {
        return "INC-{incident}"
    }
}
