// Corps de EvtNuages : nuages de débris (id = évènement).
flesh EvtNuages {
    on amorcer(h, nuage, touches) {
        require regimes.get(nuage) == () else Existe "nuage {nuage} déjà amorcé"
        let regs_a = _distincts(touches)
        let n_r = len(regs_a)
        require n_r >= 1 && n_r <= MAX_REGIMES else HorsBornes "{n_r} régime(s) touché(s), 1 à {MAX_REGIMES} attendus"
        for reg in regs_a {
            require _regime_valide(reg) else HorsBornes "régime inconnu : {reg}"
        }
        require regimes.size < MAX_NUAGES else Plein "plafond de {MAX_NUAGES} nuages atteint"
        let fin = h + DUREE_RENFORCE_MS
        regimes.set(nuage, regs_a)
        renforce_jusqua.set(nuage, fin)
        amorce_le.set(nuage, h)
        catalogues.set(nuage, 0)
        rentres.set(nuage, 0)
        for reg in regs_a {
            let _ = ApiConjonctions.renforcer(h, Regime(reg), fin, "nuage de débris {nuage}", "systeme")
        }
        return n_r
    }

    on estimer(h, nuage, nb, m, dv, basse, haute, touches, par) {
        let st_ev = EvtEvenements.etat(nuage)
        require st_ev != "inconnu" else Inconnu "évènement inconnu : {nuage}"
        let st = get_status(nuage) ?? "estime"
        require st == "estime" || st == "en_catalogage" else EtatInvalide "nuage {nuage} {st} : plus d'estimation"
        require ApiAcces.a_le_role(par, "analyste") else Habilitation "{par} n'est pas analyste d'ORBITE"
        require nb <= MAX_FRAGMENTS else HorsBornes "{nb} fragments : au plus {MAX_FRAGMENTS}"
        let regs_e = _distincts(touches)
        let n_r = len(regs_e)
        require n_r >= 1 && n_r <= MAX_REGIMES else HorsBornes "{n_r} régime(s) touché(s), 1 à {MAX_REGIMES} attendus"
        for reg in regs_e {
            require _regime_valide(reg) else HorsBornes "régime inconnu : {reg}"
        }
        require basse <= haute else Incoherent "couche inversée : {basse} > {haute}"
        let anciens = regimes.get(nuage) ?? []
        estime_nb.set(nuage, nb)
        masse.set(nuage, m)
        dispersion.set(nuage, dv)
        // ordre d'écriture compatible avec l'invariant basse <= haute
        altitude_basse.set(nuage, 0)
        altitude_haute.set(nuage, haute)
        altitude_basse.set(nuage, basse)
        regimes.set(nuage, regs_e)
        let regs_txt = join(regs_e, ",")
        let ligne = "{h} | {par} | {nb} | {m} | {dv} | {basse}-{haute} | {regs_txt}"
        let hist = estimations.get(nuage) ?? []
        hist.push(ligne)
        estimations.set(nuage, hist)
        let fin = renforce_jusqua.get(nuage) ?? (h + DUREE_RENFORCE_MS)
        if fin > h {
            for reg in regs_e {
                if !contains(anciens, reg) {
                    let _ = ApiConjonctions.renforcer(h, Regime(reg), fin, "nuage de débris {nuage} (régime ajouté)", "systeme")
                }
            }
        }
        if st_ev == "confirme" {
            let objs_e = EvtEvenements.objets(nuage)
            if len(objs_e) > 0 {
                let _ = EvtNotifications.diffuser(h, nuage, "nuage", Objet(objs_e[0]), regs_e)
            }
        }
        let _ = Journal.noter(h, "evenements", par, "nuage {nuage} estimé : {ligne}")
        return nb
    }

    on ouvrir(h, nuage) {
        require regimes.get(nuage) != () else Inconnu "nuage jamais amorcé : {nuage}"
        let st = get_status(nuage) ?? "estime"
        require st == "estime" else EtatInvalide "nuage {nuage} {st}"
        require EvtEvenements.etat(nuage) == "confirme" else EtatInvalide "évènement {nuage} non confirmé : pas de catalogage"
        transition(nuage, "estime", "en_catalogage")
        let _ = Journal.noter(h, "evenements", "systeme", "nuage {nuage} en catalogage")
        return "en_catalogage"
    }

    on abandonner(h, nuage) {
        let st = get_status(nuage) ?? "estime"
        require st == "estime" else EtatInvalide "nuage {nuage} {st}"
        require EvtEvenements.etat(nuage) == "infirme" else EtatInvalide "évènement {nuage} non infirmé : le nuage ne s'abandonne pas"
        transition(nuage, "estime", "abandonne")
        let _ = Journal.noter(h, "evenements", "systeme", "nuage {nuage} abandonné")
        return "abandonne"
    }

    on compter_fragment(nuage) {
        let st = get_status(nuage) ?? "estime"
        require st == "en_catalogage" || st == "stabilise" else EtatInvalide "nuage {nuage} {st} : aucun fragment à compter"
        let c = (catalogues.get(nuage) ?? 0) + 1
        require c <= MAX_FRAGMENTS else Plein "nuage {nuage} : {MAX_FRAGMENTS} fragments catalogués"
        catalogues.set(nuage, c)
        return c
    }

    on compter_rentree(nuage) {
        let n_r = (rentres.get(nuage) ?? 0) + 1
        // le cadre ne lit pas `catalogues` : l'invariant rentres <= catalogues tranche
        let w = try { rentres.set(nuage, n_r) }
        if w.error != () { fail("Incoherent", "nuage {nuage} : plus de rentrés que de catalogués") }
        return n_r
    }

    on prolonger(h, nuage, jusqua, motif, par) {
        let regs_p = regimes.get(nuage)
        require regs_p != () else Inconnu "nuage inconnu : {nuage}"
        let st = get_status(nuage) ?? "estime"
        require st != "dissipe" && st != "abandonne" else EtatInvalide "nuage {nuage} {st}"
        let fin = renforce_jusqua.get(nuage) ?? 0
        require jusqua > fin && jusqua <= h + PROLONGATION_MAX_MS else HorsBornes "fin {jusqua} hors de ]{fin}, h + {PROLONGATION_MAX_MS}]"
        require len(motif) > 0 else MotifRequis "motif de la prolongation vide"
        require ApiAcces.a_le_role(par, "analyste") else Habilitation "{par} n'est pas analyste d'ORBITE"
        renforce_jusqua.set(nuage, jusqua)
        for reg in regs_p {
            let _ = ApiConjonctions.renforcer(h, Regime(reg), jusqua, "nuage de débris {nuage} prolongé : {motif}", "systeme")
        }
        let _ = Journal.noter(h, "evenements", par, "nuage {nuage} : criblage renforcé jusqu'à {jusqua} ({motif})")
        return jusqua
    }

    on stabiliser(h, nuage, s, motif, par, valideur) {
        let cat = catalogues.get(nuage)
        require cat != () else Inconnu "nuage inconnu : {nuage}"
        let st = get_status(nuage) ?? "estime"
        require st == "en_catalogage" else EtatInvalide "nuage {nuage} {st}"
        require ApiAcces.a_le_role(par, "analyste") else Habilitation "{par} n'est pas analyste d'ORBITE"
        if s == "seuil" {
            let est = estime_nb.get(nuage)
            require est != () else Insuffisant "nuage {nuage} jamais estimé"
            require cat * 100 >= SEUIL_STABLE_PCT * est else Insuffisant "{cat} fragments catalogués sur {est} estimés"
        } else {
            require len(motif) > 0 else MotifRequis "stabilisation par décision sans motif"
            require ApiAcces.a_le_role(valideur, "superviseur") else Habilitation "{valideur} n'est pas superviseur d'ORBITE"
            require ApiAcces.quatre_yeux(par, valideur) else QuatreYeux "{valideur} ne contre-signe pas {par}"
        }
        let val = if s == "seuil" { "" } else { valideur }
        stabilisation.set(nuage, "{h} | {s} | {par} | {motif}")
        transition(nuage, "en_catalogage", "stabilise")
        let _ = Journal.noter(h, "evenements", par, "nuage {nuage} stabilisé ({s}) {val}")
        return "stabilise"
    }

    on dissiper(h, nuage, par) {
        require ApiAcces.a_le_role(par, "analyste") || ApiAcces.a_le_role(par, "systeme") else Habilitation "{par} ne dissipe pas de nuage"
        let cat = catalogues.get(nuage)
        require cat != () else Inconnu "nuage inconnu : {nuage}"
        let st = get_status(nuage) ?? "estime"
        let fin = renforce_jusqua.get(nuage) ?? 0
        if st == "en_catalogage" {
            let ren = rentres.get(nuage) ?? 0
            require ren == cat else Insuffisant "nuage {nuage} : {cat} fragments catalogués, {ren} rentrés"
            require h > fin else Delai "criblage renforcé de {nuage} jusqu'à {fin}"
            transition(nuage, "en_catalogage", "dissipe")
        } else if st == "stabilise" {
            require h > fin else Delai "criblage renforcé de {nuage} jusqu'à {fin}"
            transition(nuage, "stabilise", "dissipe")
        } else {
            fail("EtatInvalide", "nuage {nuage} {st}")
        }
        let _ = Journal.noter(h, "evenements", par, "nuage {nuage} dissipé")
        return "dissipe"
    }

    on actif(regime, h) {
        let reg = to_string(regime)
        for k in regimes.keys {
            let regs_k = regimes.get(k) ?? []
            if contains(regs_k, reg) {
                let st = get_status(k) ?? "estime"
                if st == "en_catalogage" { return true }
                if (st == "estime" || st == "stabilise") && h <= (renforce_jusqua.get(k) ?? 0) { return true }
            }
        }
        return false
    }

    on regimes_de(nuage) {
        return regimes.get(nuage) ?? []
    }

    on a_dissiper(h, n) {
        let res_d = []
        for k in renforce_jusqua.keys {
            if len(res_d) >= n { break }
            let st = get_status(k) ?? "estime"
            let fin = renforce_jusqua.get(k) ?? 0
            if h > fin {
                if st == "stabilise" {
                    res_d.push(k)
                } else if st == "en_catalogage" && (rentres.get(k) ?? 0) == (catalogues.get(k) ?? 0) {
                    res_d.push(k)
                }
            }
        }
        return res_d
    }

    on etat(nuage) {
        if regimes.get(nuage) == () { return "inconnu" }
        return get_status(nuage) ?? "estime"
    }

    on _distincts(xs: List<String>) {
        let vus = []
        for x in xs {
            if !contains(vus, x) { vus.push(x) }
        }
        return vus
    }

    on _regime_valide(reg: String) {
        return reg == "leo" || reg == "meo" || reg == "geo" || reg == "heo"
    }
}
