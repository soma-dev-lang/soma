// acces — corps des facteurs d'authentification, des sessions et des jetons.
flesh AccesFacteurs {
    on enroler(h, personne, empreinte_cle, par) {
        let emp = AccesPersonnes.employeur(personne)
        require emp != "" else Inconnu "personne {personne} inconnue"
        require AccesPersonnes.est_active(personne) else Suspendu "personne {personne} non active"
        let st = get_status(personne) ?? "absent"
        require st == "absent" else EtatInvalide "facteur de {personne} {st}"
        require par != personne else QuatreYeux "{par} ne peut enrôler sa propre clé"
        let ok = AccesControle.a_le_role(par, "exploitant") || (AccesControle.a_le_role(par, "administrateur_operateur") && AccesControle.agit_pour(par, emp))
        require ok else Habilitation "{par} ne peut enrôler le facteur de {personne}"
        require empreinte_cle != "" else Habilitation "empreinte de clé vide"
        require len(cle_de.entries.filter(e => e.value == empreinte_cle && e.key != personne)) == 0 else Doublon "clé déjà enrôlée pour une autre personne"
        cle_de.set(personne, empreinte_cle)
        enrole_par.set(personne, par)
        echecs.set(personne, 0)
        transition(personne, "absent", "enrole")
        let _ = Journal.noter(h, "acces", par, "enroler facteur de {personne}")
        return "enrole"
    }

    on verifier(h, personne, facteur) {
        let cle = cle_de.get(personne)
        require cle != () else Inconnu "aucun facteur pour {personne}"
        let st = get_status(personne) ?? "absent"
        require st == "enrole" else EtatInvalide "facteur de {personne} {st}"
        if facteur != "" && facteur == cle {
            echecs.set(personne, 0)
            return true
        }
        let n = (echecs.get(personne) ?? 0) + 1
        if n >= MAX_ECHECS {
            echecs.set(personne, MAX_ECHECS)
            transition(personne, "enrole", "bloque")
            let _ = Journal.noter(h, "acces", "systeme", "facteur de {personne} bloqué après {n} échecs")
        } else {
            echecs.set(personne, n)
        }
        return false
    }

    on compromettre(h, personne, par) {
        let emp = AccesPersonnes.employeur(personne)
        require emp != "" else Inconnu "personne {personne} inconnue"
        let st = get_status(personne) ?? "absent"
        require st == "enrole" else EtatInvalide "facteur de {personne} {st}"
        let ok = par == personne || AccesControle.a_le_role(par, "exploitant") || (AccesControle.a_le_role(par, "administrateur_operateur") && AccesControle.agit_pour(par, emp))
        require ok else Habilitation "{par} ne peut déclarer compromis le facteur de {personne}"
        transition(personne, "enrole", "bloque")
        let n = AccesSessions.fermer_toutes(h, personne, "compromission")
        let _ = Journal.noter(h, "acces", par, "compromettre facteur de {personne} ({n} sessions fermées)")
        return "bloque"
    }

    on debloquer(h, personne, empreinte_cle, par, valideur) {
        let emp = AccesPersonnes.employeur(personne)
        require emp != "" else Inconnu "personne {personne} inconnue"
        let st = get_status(personne) ?? "absent"
        require st == "bloque" else EtatInvalide "facteur de {personne} {st}"
        require AccesPersonnes.est_active(personne) else Suspendu "personne {personne} non active"
        require par != personne && valideur != personne else QuatreYeux "la personne ne débloque pas son propre facteur"
        let ok = AccesControle.a_le_role(par, "exploitant") || (AccesControle.a_le_role(par, "administrateur_operateur") && AccesControle.agit_pour(par, emp))
        require ok else Habilitation "{par} ne peut débloquer le facteur de {personne}"
        if empreinte_cle != "" {
            require len(cle_de.entries.filter(e => e.value == empreinte_cle && e.key != personne)) == 0 else Doublon "clé déjà enrôlée pour une autre personne"
            cle_de.set(personne, empreinte_cle)
        }
        let _ = AccesControle.contresigner(h, "deblocage:{personne}", par, valideur)
        enrole_par.set(personne, par)
        echecs.set(personne, 0)
        transition(personne, "bloque", "enrole")
        let _ = Journal.noter(h, "acces", par, "debloquer facteur de {personne}, validé par {valideur}")
        return "enrole"
    }

    on revoquer(h, personne) {
        let st = get_status(personne) ?? "absent"
        if st == "revoque" { return "revoque" }
        if st == "enrole" {
            transition(personne, "enrole", "revoque")
        } else if st == "bloque" {
            transition(personne, "bloque", "revoque")
        } else {
            transition(personne, "absent", "revoque")
        }
        let _ = Journal.noter(h, "acces", "systeme", "revoquer facteur de {personne}")
        return "revoque"
    }

    on utilisable(personne) {
        return (get_status(personne) ?? "absent") == "enrole"
    }
}

flesh AccesSessions {
    on ouvrir(h, personne, facteur) {
        let emp = AccesPersonnes.employeur(personne)
        require emp != "" else Inconnu "personne {personne} inconnue"
        require AccesPersonnes.est_active(personne) else Suspendu "personne {personne} non active"
        require AccesFacteurs.utilisable(personne) else Habilitation "facteur de {personne} non utilisable"
        // Un facteur invalide rend "" SANS lever : lever annulerait le compte d'échecs de
        // AccesFacteurs.verifier (gestes atomiques) et ouvrirait la porte à la force brute.
        if !AccesFacteurs.verifier(h, personne, facteur) {
            let _ = Journal.noter(h, "acces", personne, "ouvrir session refusée : facteur invalide")
            return ""
        }
        require personne_de_session.size < MAX_SESSIONS else Plein "registre des sessions plein"
        let n = ouvertes.get(personne) ?? 0
        require n < MAX_PAR_PERSONNE else Plein "{personne} a déjà {n} sessions"
        let canal_s = if AccesUrgences.ouverte_pour(personne) { "urgence" } else if emp == ApiRef.orbite() { "console" } else { "api" }
        let id = "s-{next_id()}"
        personne_de_session.set(id, personne)
        canal.set(id, AccesCanal(canal_s))
        derniere_activite.set(id, h)
        ouverte_a.set(id, h)
        ouvertes.set(personne, n + 1)
        transition(id, "nouvelle", "ouverte")
        let secret = AccesJetons.emettre(h, id)
        let _ = Journal.noter(h, "acces", personne, "ouvrir session {id} ({canal_s})")
        return secret
    }

    on toucher(h, session) {
        let p = personne_de_session.get(session)
        require p != () else Inconnu "session {session} inconnue"
        let st = get_status(session) ?? "nouvelle"
        require st == "ouverte" else Ferme "session {session} {st}"
        let d = to_int(derniere_activite.get(session) ?? 0)
        let o = to_int(ouverte_a.get(session) ?? 0)
        let lim = if (canal.get(session) ?? "api") == "console" { INACTIVITE_CONSOLE_MS } else { INACTIVITE_API_MS }
        require to_int(h) - d <= lim else Delai "session {session} inactive"
        require to_int(h) - o < DUREE_MAX_MS else Delai "session {session} au-delà de sa durée maximale"
        if to_int(h) > d { derniere_activite.set(session, h) }
        return p
    }

    on deverrouiller(h, session, facteur) {
        let p = personne_de_session.get(session)
        require p != () else Inconnu "session {session} inconnue"
        let st = get_status(session) ?? "nouvelle"
        require st == "verrouillee" else EtatInvalide "session {session} {st}"
        let o = to_int(ouverte_a.get(session) ?? 0)
        require to_int(h) - o < DUREE_MAX_MS else Delai "session {session} au-delà de sa durée maximale"
        require AccesPersonnes.est_active(p) else Suspendu "personne {p} non active"
        let v = try { AccesFacteurs.verifier(h, p, facteur) }
        require v.error == () else Habilitation "facteur de {p} non utilisable"
        // Facteur invalide : la session reste verrouillée, l'échec reste compté (pas de levée).
        if !v.value { return "verrouillee" }
        derniere_activite.set(session, h)
        transition(session, "verrouillee", "ouverte")
        return "ouverte"
    }

    on fermer(h, jeton, par) {
        let s = AccesJetons.session_de(jeton)
        require s != "" else Inconnu "jeton inconnu"
        let p = personne_de_session.get(s) ?? ""
        let st = get_status(s) ?? "nouvelle"
        require st == "ouverte" || st == "verrouillee" else EtatInvalide "session {s} {st}"
        require par == p || AccesControle.a_le_role(par, "exploitant") || AccesControle.a_le_role(par, "systeme") else Habilitation "{par} ne peut fermer la session {s}"
        _clore(h, s, st, p, "deconnexion")
        let _ = Journal.noter(h, "acces", par, "fermer session {s}")
        return "fermee"
    }

    on fermer_toutes(h, personne, m) {
        let ids = personne_de_session.entries.filter(e => e.value == personne && ((get_status(e.key) ?? "nouvelle") == "ouverte" || (get_status(e.key) ?? "nouvelle") == "verrouillee")).map(e => e.key).sort()
        for s in ids { _clore(h, s, get_status(s) ?? "nouvelle", personne, m) }
        if len(ids) > 0 {
            let _ = Journal.noter(h, "acces", "systeme", "fermer {len(ids)} sessions de {personne} ({m})")
        }
        return len(ids)
    }

    on balayer(h) {
        let ids = personne_de_session.entries.filter(e => (get_status(e.key) ?? "nouvelle") == "ouverte" || (get_status(e.key) ?? "nouvelle") == "verrouillee").map(e => e.key).sort()
        let touchees = 0
        for s in ids {
            let st = get_status(s) ?? "nouvelle"
            let o = to_int(ouverte_a.get(s) ?? 0)
            let d = to_int(derniere_activite.get(s) ?? 0)
            let lim = if (canal.get(s) ?? "api") == "console" { INACTIVITE_CONSOLE_MS } else { INACTIVITE_API_MS }
            if to_int(h) - o >= DUREE_MAX_MS {
                _clore(h, s, st, personne_de_session.get(s) ?? "", "duree_max")
                touchees = touchees + 1
            } else if st == "ouverte" && to_int(h) - d > lim {
                transition(s, "ouverte", "verrouillee")
                touchees = touchees + 1
            }
        }
        if touchees > 0 {
            let _ = Journal.noter(h, "acces", "systeme", "balayer sessions : {touchees} touchées")
        }
        return touchees
    }

    on titulaire(session) {
        return personne_de_session.get(session) ?? ""
    }

    on est_ouverte(session) {
        return (get_status(session) ?? "nouvelle") == "ouverte"
    }

    on _clore(h: Horodatage, s: String, st: String, p: String, m: AccesMotifFin) {
        motif_fin.set(s, m)
        ouvertes.set(p, max(0, (ouvertes.get(p) ?? 0) - 1))
        if st == "ouverte" {
            transition(s, "ouverte", "fermee")
        } else {
            transition(s, "verrouillee", "fermee")
        }
        let _ = AccesJetons.revoquer_session(h, s)
    }
}

flesh AccesJetons {
    on emettre(h, session) {
        require AccesSessions.est_ouverte(session) else Ferme "session {session} non ouverte"
        require session_du_jeton.size < MAX_JETONS && jeton_par_empreinte.size < MAX_JETONS else Plein "registre des jetons plein"
        let secret = random_token()
        let id = "j-{next_id()}"
        session_du_jeton.set(id, session)
        jeton_par_empreinte.set(sha256(secret), id)
        expire_a.set(id, Horodatage(to_int(h) + DUREE_MS))
        emis_a.set(id, h)
        transition(id, "prepare", "emis")
        let _ = Journal.noter(h, "acces", "systeme", "emettre jeton {id} pour {session}")
        return secret
    }

    on authentifier(jeton, h) {
        if jeton == "" { return "" }
        let id = jeton_par_empreinte.get(sha256(jeton))
        if id == () { return "" }
        if (get_status(id) ?? "prepare") != "emis" { return "" }
        if to_int(expire_a.get(id) ?? 0) <= to_int(h) { return "" }
        let s = session_du_jeton.get(id) ?? ""
        let t = try { AccesSessions.toucher(h, s) }
        if t.error != () { return "" }
        let p = t.value
        if p == "systeme" || p == "" { return "" }
        if !AccesPersonnes.est_active(p) { return "" }
        return p
    }

    on session_de(jeton) {
        if jeton == "" { return "" }
        let id = jeton_par_empreinte.get(sha256(jeton))
        if id == () { return "" }
        return session_du_jeton.get(id) ?? ""
    }

    on revoquer_session(h, session) {
        let ids = session_du_jeton.entries.filter(e => e.value == session && (get_status(e.key) ?? "prepare") == "emis").map(e => e.key)
        for id in ids { transition(id, "emis", "revoque") }
        return len(ids)
    }

    on echoir(h) {
        let ids = expire_a.entries.filter(e => to_int(e.value) <= to_int(h) && (get_status(e.key) ?? "prepare") == "emis").map(e => e.key)
        let echus = map()
        for id in ids {
            transition(id, "emis", "expire")
            echus[id] = true
        }
        if len(ids) > 0 {
            let empreintes = jeton_par_empreinte.entries.filter(e => echus[e.value] ?? false).map(e => e.key)
            for k in empreintes { jeton_par_empreinte.delete(k) }
        }
        return len(ids)
    }
}
