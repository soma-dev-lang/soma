            let k = r.kind
            let _ = Journal.noter(h, "fin_de_vie", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "fin_de_vie", qui, "admin {geste} : fait")
        return r.value
    }
    on router_lancements(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiLancements.notifier" -> ApiLancements.notifier(h, _s(corps, "lancement"), Org(_s(corps, "op")), Etat(_s(corps, "etat")), Horodatage(_i(corps, "debut")), Horodatage(_i(corps, "fin")), Regime(_s(corps, "regime")), _i(corps, "nb_objets"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur lancements")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "lancements", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "lancements", qui, "admin {geste} : fait")
        return r.value
    }
    on router_manoeuvres(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiManoeuvres.annuler" -> ApiManoeuvres.annuler(h, _s(corps, "plan"), _s(corps, "motif"), qui)
                "ApiManoeuvres.retirer" -> ApiManoeuvres.retirer(h, _s(corps, "plan"), _s(corps, "motif"), qui)
                "ApiManoeuvres.constater_non_annoncee" -> ApiManoeuvres.constater_non_annoncee(h, Objet(_s(corps, "objet")), Horodatage(_i(corps, "depuis")), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur manoeuvres")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "manoeuvres", qui, "admin {geste} : refus {k}")
