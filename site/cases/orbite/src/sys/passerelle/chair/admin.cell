// PASSERELLE — corps des routeurs d'administration (généré depuis les fiches des gestes :
// sys/passerelle/admin.cell + les façades). Arguments lus dans `corps` par leur nom de paramètre ;
// `h`, `par`, `valideur` jamais lus dans le corps. Un champ manquant ou mal typé lève HorsBornes
// ("champ …", 400) ; une valeur hors de son type nominal lève OutOfRange (400 côté PasEntree).
// Le refus d'un geste est journalisé puis relevé : comme le geste est atomique, la ligne du
// routeur disparaît avec lui, et c'est la ligne finale de PasEntree.traiter qui garde la trace.

flesh PasAdmin {
    on router_acces(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiAcces.enregistrer" -> ApiAcces.enregistrer(h, _s(corps, "personne"), Org(_s(corps, "employeur")), Role(_s(corps, "r")), qui)
                "ApiAcces.suspendre" -> ApiAcces.suspendre(h, _s(corps, "personne"), _s(corps, "motif"), qui)
                "ApiAcces.retablir" -> ApiAcces.retablir(h, _s(corps, "personne"), qui)
                "ApiAcces.ouvrir_urgence" -> ApiAcces.ouvrir_urgence(h, _s(corps, "personne"), Rapprochement(_s(corps, "r")), _s(corps, "motif"), qui)
                "ApiAcces.fermer_session" -> ApiAcces.fermer_session(h, _s(corps, "jeton"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur acces")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "acces", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "acces", qui, "admin {geste} : fait")
        return r.value
    }
    on router_conformite(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiConformite.constater" -> ApiConformite.constater(h, Org(_s(corps, "op")), _s(corps, "nature"), Gravite(_i(corps, "gravite")), _s(corps, "reference"), qui)
                "ApiConformite.constater_etat" -> ApiConformite.constater_etat(h, Etat(_s(corps, "etat")), _s(corps, "nature"), Gravite(_i(corps, "gravite")), _s(corps, "reference"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur conformite")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "conformite", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "conformite", qui, "admin {geste} : fait")
        return r.value
    }
    on router_conjonctions(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiConjonctions.signaler" -> ApiConjonctions.signaler(h, Objet(_s(corps, "objet_a")), Objet(_s(corps, "objet_b")), Horodatage(_i(corps, "tca")), Distance(_i(corps, "distance")), Probabilite(_i(corps, "pc")), qui)
                "ApiConjonctions.resoudre" -> ApiConjonctions.resoudre(h, Rapprochement(_s(corps, "r")), _s(corps, "motif"), qui)
                "ApiConjonctions.constater_collision" -> ApiConjonctions.constater_collision(h, Rapprochement(_s(corps, "r")), _s(corps, "evenement"), qui)
                "ApiConjonctions.exempter" -> ApiConjonctions.exempter(h, Objet(_s(corps, "chasseur")), Objet(_s(corps, "cible")), Horodatage(_i(corps, "debut")), Horodatage(_i(corps, "fin")), qui, valideur)
                "ApiConjonctions.renforcer" -> ApiConjonctions.renforcer(h, Regime(_s(corps, "regime")), Horodatage(_i(corps, "fin")), _s(corps, "motif"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur conjonctions")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "conjonctions", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "conjonctions", qui, "admin {geste} : fait")
        return r.value
    }
    on router_coordination(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiCoordination.ouvrir" -> ApiCoordination.ouvrir(h, Rapprochement(_s(corps, "r")), qui)
                "ApiCoordination.arbitrer" -> ApiCoordination.arbitrer(h, Rapprochement(_s(corps, "r")), Objet(_s(corps, "objet")), _s(corps, "motif"), qui, valideur)
                "ApiCoordination.rouvrir" -> ApiCoordination.rouvrir(h, Rapprochement(_s(corps, "r")), _s(corps, "motif"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur coordination")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "coordination", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "coordination", qui, "admin {geste} : fait")
        return r.value
    }
    on router_donnees(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let _ = Journal.noter(h, "donnees", qui, "admin {geste} : inconnu")
        fail("Inconnu", "geste {geste} : donnees n'expose aucun geste d'administration")
    }
    on router_ephemerides(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiEphemerides.invalider" -> ApiEphemerides.invalider(h, Objet(_s(corps, "objet")), _s(corps, "motif"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur ephemerides")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "ephemerides", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "ephemerides", qui, "admin {geste} : fait")
        return r.value
    }
    on router_escalade(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiEscalade.escalader" -> ApiEscalade.escalader(h, Rapprochement(_s(corps, "r")), Org(_s(corps, "op")), _s(corps, "motif"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur escalade")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "escalade", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "escalade", qui, "admin {geste} : fait")
        return r.value
    }
    on router_evenements(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiEvenements.declarer" -> ApiEvenements.declarer(h, _s(corps, "genre"), _l(corps, "objets"), Rapprochement(_s(corps, "r")), Horodatage(_i(corps, "instant")), _s(corps, "description"), qui, valideur)
                "ApiEvenements.anomalie" -> ApiEvenements.anomalie(h, Objet(_s(corps, "objet")), _s(corps, "genre"), _s(corps, "description"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur evenements")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "evenements", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "evenements", qui, "admin {geste} : fait")
