        let _ = Journal.noter(h, "manoeuvres", qui, "admin {geste} : fait")
        return r.value
    }
    on router_meteo(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let _ = Journal.noter(h, "meteo", qui, "admin {geste} : inconnu")
        fail("Inconnu", "geste {geste} : meteo n'expose aucun geste d'administration")
    }
    on router_observation(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiObservation.demander_suivi" -> ApiObservation.demander_suivi(h, Objet(_s(corps, "objet")), Niveau(_i(corps, "priorite")), Duree(_i(corps, "duree")), _s(corps, "motif"), qui)
                "ApiObservation.deposer_mesure" -> ApiObservation.deposer_mesure(h, _s(corps, "capteur"), Objet(_s(corps, "objet")), Horodatage(_i(corps, "instant")), _s(corps, "mesure"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur observation")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "observation", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "observation", qui, "admin {geste} : fait")
        return r.value
    }
    on router_operateurs(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiOperateurs.suspendre" -> ApiOperateurs.suspendre(h, Org(_s(corps, "op")), _s(corps, "motif"), qui, valideur)
                "ApiOperateurs.retablir" -> ApiOperateurs.retablir(h, Org(_s(corps, "op")), qui, valideur)
                _ -> fail("Inconnu", "geste {geste} hors du routeur operateurs")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "operateurs", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "operateurs", qui, "admin {geste} : fait")
        return r.value
    }
    on router_operations(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiOperations.declarer_incident" -> ApiOperations.declarer_incident(h, _s(corps, "incident"), Gravite(_i(corps, "gravite")), SousSysteme(_s(corps, "sous_systeme")), _s(corps, "description"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur operations")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "operations", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "operations", qui, "admin {geste} : fait")
        return r.value
    }
    on router_priorites(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let _ = Journal.noter(h, "priorites", qui, "admin {geste} : inconnu")
        fail("Inconnu", "geste {geste} : priorites n'expose aucun geste d'administration")
    }
    on router_reentrees(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiReentrees.prevoir" -> ApiReentrees.prevoir(h, Objet(_s(corps, "objet")), Horodatage(_i(corps, "debut")), Horodatage(_i(corps, "fin")), _i(corps, "victimes_ppm"), qui)
                "ApiReentrees.constater" -> ApiReentrees.constater(h, Objet(_s(corps, "objet")), Horodatage(_i(corps, "instant")), _s(corps, "lieu"), _b(corps, "debris_au_sol"), qui, valideur)
                _ -> fail("Inconnu", "geste {geste} hors du routeur reentrees")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "reentrees", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "reentrees", qui, "admin {geste} : fait")
        return r.value
    }
    on router_ref(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiRef.inscrire_organisation" -> ApiRef.inscrire_organisation(h, Org(_s(corps, "org")), _s(corps, "nom"), Etat(_s(corps, "etat")), _s(corps, "genre"), qui, valideur)
                "ApiRef.cataloguer" -> ApiRef.cataloguer(h, NatureObjet(_s(corps, "nature")), Org(_s(corps, "proprietaire")), Etat(_s(corps, "etat")), Regime(_s(corps, "regime")), Propulsion(_s(corps, "propulsion")), Masse(_i(corps, "masse")), qui)
                "ApiRef.changer_etat_objet" -> ApiRef.changer_etat_objet(h, Objet(_s(corps, "objet")), _s(corps, "cible"), _s(corps, "reference"), _s(corps, "motif"), qui)
                "ApiRef.declarer_propulsion" -> ApiRef.declarer_propulsion(h, Objet(_s(corps, "objet")), Propulsion(_s(corps, "p")), _s(corps, "motif"), qui)
                "ApiRef.attribuer" -> ApiRef.attribuer(h, Objet(_s(corps, "objet")), Org(_s(corps, "proprietaire")), Etat(_s(corps, "etat")), qui, valideur)
                "ApiRef.immatriculer" -> ApiRef.immatriculer(h, Objet(_s(corps, "objet")), _s(corps, "numero"), qui)
                "ApiRef.changer_regime" -> ApiRef.changer_regime(h, Objet(_s(corps, "objet")), Regime(_s(corps, "r")), qui)
                "ApiRef.changer_tutelle" -> ApiRef.changer_tutelle(h, Org(_s(corps, "org")), Etat(_s(corps, "etat")), qui, valideur)
                _ -> fail("Inconnu", "geste {geste} hors du routeur ref")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "ref", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "ref", qui, "admin {geste} : fait")
        return r.value
    }
    on router_responsabilite(h, appelant, valideur, geste, corps) {
        let qui = _prealable(appelant, corps)
        let r = try {
            match geste {
                "ApiResponsabilite.geler" -> ApiResponsabilite.geler(h, _s(corps, "evenement"), _s(corps, "motif"), qui)
                _ -> fail("Inconnu", "geste {geste} hors du routeur responsabilite")
            }
        }
        if r.error != () {
            let k = r.kind
            let _ = Journal.noter(h, "responsabilite", qui, "admin {geste} : refus {k}")
            fail(r)
        }
        let _ = Journal.noter(h, "responsabilite", qui, "admin {geste} : fait")
        return r.value
    }

    // ── aides

    // Contrôle préalable : un rôle effectif (jamais "aucun" ni "systeme"), dans sa portée ; aucun
    // `h`, `par` ou `valideur` dans le corps. Renvoie la personne (le `par` des gestes).
    on _prealable(appelant: PasAppelant, corps: Map) {
        let qui = match appelant { PasAppelant { personne, org, role } -> personne }
        let son_org = match appelant { PasAppelant { personne, org, role } -> org }
        let role = match appelant { PasAppelant { personne, org, role } -> role }
        require corps["par"] == () && corps["valideur"] == () && corps["h"] == () else HorsBornes "champ par / valideur / h interdit dans le corps"
        require role != "aucun" && role != "systeme" && qui != "systeme" else Habilitation "aucun rôle"
        let orbite_r = role == "analyste" || role == "superviseur" || role == "exploitant" || role == "conformite" || role == "direction" || role == "auditeur"
        if orbite_r {
            require ApiAcces.a_le_role(qui, role) else Habilitation "rôle {role} hors de sa portée"
        } else {
            require ApiAcces.agit_pour(qui, son_org) else Habilitation "{qui} n'agit pas pour {son_org}"
        }
        return qui
    }
    on _s(corps: Map, nom: String) {
        let v = corps[nom]
        require v != () && type_of(v) == "String" else HorsBornes "champ {nom} manquant ou non textuel"
        return v
    }
    on _i(corps: Map, nom: String) {
        let v = corps[nom]
        require v != () && type_of(v) == "Int" else HorsBornes "champ {nom} manquant ou non entier"
        return v
    }
    on _b(corps: Map, nom: String) {
        let v = corps[nom]
        require v != () && type_of(v) == "Bool" else HorsBornes "champ {nom} manquant ou non booléen"
        return v
    }
    on _l(corps: Map, nom: String) {
        let v = corps[nom]
        require v != () && type_of(v) == "List" else HorsBornes "champ {nom} manquant ou non liste"
        for x in v {
            require type_of(x) == "String" else HorsBornes "champ {nom} : liste de textes attendue"
        }
        return v
    }
}
