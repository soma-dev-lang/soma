// ── 4. Criblage → rapprochement de niveau 3 → coordination ouverte, proposition par défaut.
cell test E4Criblage {
    rules {
        mock random_token ["DEFI-C-OPA", "DEFI-C-OPB"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.amorcer() == "ok"
        assert Monde.lancement() == "autorise"
        let objs = Monde.tir()
        assert Monde.observer() == "injecte"
        assert Monde.catalogue_crible() == "1,3,129600000,150;2,4,172800000,120;2,5,151200000,100"
        let rs = Monde.cribler(Monde.h(20827, 3600), ["A1|B1"])
        assert len(rs) == 1
        let r = rs[0]
        assert ApiConjonctions.niveau(r) == 3
        assert ApiConjonctions.etat(r) == "en_coordination"
        assert ApiRef.peut_manoeuvrer(Monde.objet("A1"))
        assert ApiPriorites.qui_manoeuvre(Monde.h(20827, 3800), r, Monde.objet("A1"), Monde.objet("B1")) == Monde.objet("A1")
        assert ApiCoordination.etat(r) == "proposee"
        assert ApiCoordination.decision(r) == ""
        assert ApiCoordination.en_attente_de("ORG-OPA") == [r]
    }
}

// ── 5. Branche A : OPA accepte, désignation arrêtée, plan d'évitement criblé et approuvé,
// exécuté, vérifié ; rapprochement résolu. Propriété 1 : un second plan refusé.
cell test E5BrancheA {
    rules {
        mock random_token ["DEFI-C-OPA", "DEFI-C-OPB"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == "injecte"
        let r = Monde.cribler(Monde.h(20827, 3600), ["A1|B1"])[0]
        assert ApiCoordination.etat(r) == "proposee"
        assert ApiCoordination.repondre(Monde.h(20827, 4000), r, "accepte", "", "", "dyn.a") == "proposee"
        assert ApiCoordination.repondre(Monde.h(20827, 4100), r, "accepte", "", "", "dyn.b") == "arretee"
        assert ApiCoordination.arretee(r)
        assert ApiCoordination.designe(r, "dyn.b") == Monde.objet("A1")
        assert Monde.plan_a1(r) == "PL-A1"
        assert ApiManoeuvres.etat("PL-A1") == "approuve"
        assert ApiConjonctions.criblage_plan("PL-A1") == "sur"
        assert ApiManoeuvres.plan_de(r) == "PL-A1"
        // propriété 1 : un seul plan d'évitement par rapprochement
        assert_fails ApiManoeuvres.declarer(Monde.h(20827, 5500), "PL-A1-BIS", Monde.objet("A1"), r, "evitement", Monde.h(20827, 23400), DeltaV(800), "dyn.a") matching "Conflit"
        assert_fails ApiManoeuvres.declarer(Monde.h(20827, 5500), "PL-B1", Monde.objet("B1"), r, "evitement", Monde.h(20827, 23400), DeltaV(800), "dyn.b") matching "Conflit"
        assert ApiManoeuvres.etat("PL-A1-BIS") == "inconnu"
        // exécution confirmée, vérification par l'observation
        assert ApiManoeuvres.confirmer_execution(Monde.h(20827, 22200), "PL-A1", Monde.h(20827, 21700), DeltaV(1000), "dyn.a") == "execute"
        assert Monde.apres_poussee() == "validee"
        assert ObsDetections.etat("MD-1") == "expliquee"
        assert !ApiObservation.manoeuvre_detectee(Monde.objet("A1"), Monde.h(20827, 0))
        assert ManVerification.verifier(Monde.h(20827, 29000), "PL-A1", "ana1") == "conforme"
        assert ApiManoeuvres.etat("PL-A1") == "verifie"
        // la vérification conforme résout le rapprochement ; le balayage clôt la coordination
        assert ApiConjonctions.etat(r) == "resolu"
        assert ApiCoordination.balayer(Monde.h(20827, 29100), "systeme") >= 1
        assert ApiCoordination.etat(r) == "close"
        assert !ApiManoeuvres.plan_actif(Monde.objet("A1"))
        assert Monde.battre_de(Monde.h(20827, 32400), Monde.h(20828, 32400), 3600000) == []
    }
}

// ── Propriétés 2 et 4 sur le rapprochement A2 / étage E1 (TCA le 10/01 18 h, deux objets d'OPA).
cell test E6Proprietes2Et4 {
    rules {
        mock random_token ["DEFI-C-OPA", "DEFI-C-OPB"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == "injecte"
        let r = Monde.cribler(Monde.h(20827, 3600), ["A2|E1"])[0]
        assert ApiConjonctions.niveau(r) == 3
        // propriété 2 : l'étage, plus léger (masse moindre ⇒ désigné par la table), n'a pas de
        // propulsion : jamais désigné ; la proposition par défaut est A2.
        assert !ApiRef.peut_manoeuvrer(Monde.objet("E1"))
        assert ApiCoordination.etat(r) == "proposee"
        let a2 = Monde.objet("A2")
        assert contains(ApiPriorites.decision_de(r), "|{a2}|")
        assert ApiCoordination.repondre(Monde.h(20827, 4000), r, "accepte", "", "", "dyn.a") == "arretee"
        assert ApiCoordination.designe(r, "ana1") == Monde.objet("A2")
        assert_fails ApiManoeuvres.declarer(Monde.h(20827, 4100), "PL-E1", Monde.objet("E1"), r, "evitement", Monde.h(20827, 43200), DeltaV(500), "dyn.a") matching "NonEligible"
        // propriété 4 : éphéméride périmée (âge > 8 h en leo) ⇒ refus Perime
        assert_fails ApiManoeuvres.declarer(Monde.h(20827, 32400), "PL-A2-1", Monde.objet("A2"), r, "evitement", Monde.h(20827, 43200), DeltaV(500), "dyn.a") matching "Perime"
        // éphéméride fraîche (incluant la poussée) mais catalogue non criblé depuis 8 h :
        // criblage impossible ⇒ plan rejeté, jamais approuvé
        assert Monde.ephemeride_a2(Monde.h(20827, 33600), "2") == "validee"
        assert ApiManoeuvres.declarer(Monde.h(20827, 33700), "PL-A2-2", Monde.objet("A2"), r, "evitement", Monde.h(20827, 43200), DeltaV(500), "dyn.a") == "PL-A2-2"
        assert ApiManoeuvres.etat("PL-A2-2") == "rejete"
        assert ApiManoeuvres.plan_de(r) == ""
        // opérateur suspendu par la conformité (quatre yeux de la direction) ⇒ refus Suspendu
        assert Monde.campagne(Monde.h(20827, 34000), 5, 10, 3) == "terminee"
        assert ApiOperateurs.suspendre(Monde.h(20827, 34200), "ORG-OPA", "manquements graves", "conf1", "dir1") == "suspendu"
        assert_fails ApiManoeuvres.declarer(Monde.h(20827, 34300), "PL-A2-3", Monde.objet("A2"), r, "evitement", Monde.h(20827, 43200), DeltaV(500), "dyn.a") matching "Suspendu"
        // rétabli : le même plan, criblé sûr, est approuvé
        assert ApiOperateurs.retablir(Monde.h(20827, 34400), "ORG-OPA", "conf1", "dir1") == "actif"
        assert ApiManoeuvres.declarer(Monde.h(20827, 34500), "PL-A2-4", Monde.objet("A2"), r, "evitement", Monde.h(20827, 43200), DeltaV(500), "dyn.a") == "PL-A2-4"
        assert ApiManoeuvres.etat("PL-A2-4") == "approuve"
    }
}

// ── 6. Branche B : OPB, désigné (B2 plus léger), reste muet ; l'horloge fait monter l'escalade
// jusqu'à la reprise par ORBITE ; arbitrage à quatre yeux ; manquement constaté chez conformite.
cell test E7BrancheB {
    rules {
        mock random_token ["DEFI-C-OPA", "DEFI-C-OPB"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == "injecte"
        let r = Monde.cribler(Monde.h(20827, 3600), ["A2|B2"])[0]
        assert ApiConjonctions.niveau(r) == 3
        assert ApiCoordination.etat(r) == "proposee"
        let b2 = Monde.objet("B2")
        assert contains(ApiPriorites.decision_de(r), "|{b2}|")
        assert ApiCoordination.repondre(Monde.h(20827, 4000), r, "accepte", "", "", "dyn.a") == "proposee"
        // l'horloge : escalade ouverte à l'échelon 2 (échéance finale à moins de 48 h), 3 une
        // demi-heure plus tard (engagement de niveau 3), 4 au bout de 15 % du temps restant (6 h) —
        // le barème seul règle le rythme (rejeu Aeolus : les relances non acquittées ne font plus
        // monter l'escalade) ; reprise par ORBITE à l'échéance finale et arbitrage ouvert ensemble,
        // à la limite d'action moins 2 h (TCA − 6 h de préavis − 2 h). Aucun balayage en erreur.
        assert Monde.veiller(r, "ORG-OPB", Monde.h(20827, 5400), Monde.h(20828, 57600), 1800000) == ["j20827 1h30 echelon=0 coord=proposee reprise=false", "j20827 2h0 echelon=2 coord=proposee reprise=false", "j20827 2h30 echelon=3 coord=proposee reprise=false", "j20827 8h30 echelon=4 coord=proposee reprise=false", "j20828 16h0 echelon=4 coord=arbitrage reprise=true"]
        assert ApiCoordination.muets(r) == ["ORG-OPB"]
        assert ApiEscalade.reprise(r)
        assert !ApiCoordination.arretee(r)
        // arbitrage d'ORBITE à quatre yeux (propriété 5) : A2, d'OPA joignable, manœuvre
        let a2 = Monde.objet("A2")
        assert_fails ApiCoordination.arbitrer(Monde.h(20828, 58200), r, a2, "OPB muet", "ana1", "ana1") matching "QuatreYeux"
        assert_fails ApiCoordination.arbitrer(Monde.h(20828, 58200), r, a2, "OPB muet", "ana1", "ana2") matching "QuatreYeux"
        assert_fails ApiCoordination.arbitrer(Monde.h(20828, 58200), r, a2, "OPB muet", "sup1", "sup2") matching "Habilitation"
        assert_fails ApiCoordination.arbitrer(Monde.h(20828, 58200), r, a2, "", "ana1", "sup1") matching "MotifRequis"
        assert ApiCoordination.arbitrer(Monde.h(20828, 58200), r, a2, "OPB muet malgré l'escalade : A2 manœuvre", "ana1", "sup1") == "arretee"
        assert ApiCoordination.designe(r, "dyn.a") == a2
        assert contains(ApiCoordination.decision(r), "|ana1|sup1|")
        // manquement « reponse_tardive » d'OPB constaté chez conformite au silence (01 h 32) :
        // le reconstater rend le même manquement, sans en ouvrir un autre
        let n_b = ConfManquement.ouverts("ORG-OPB")
        assert n_b >= 1
        let m = ApiConformite.constater(Monde.h(20828, 58400), "ORG-OPB", "reponse_tardive", 3, r, "systeme")
        assert ConfManquement.op(m) == "ORG-OPB"
        assert ConfManquement.gravite(m) == 3
        assert ConfManquement.ouverts("ORG-OPB") == n_b
        assert len(Journal.chercher("{m} constate : ORG-OPB reponse_tardive g3 reference {r}", 5)) == 1
    }
}

// ── 7. Branche C : A2 désigné ne manœuvre pas ; collision avec l'étage E1 au TCA (10/01 18 h) ;
// rapprochement en « collision », dossier de preuve gelé, chaîne de preuve de la décision ;
// propriété 6 : la désignation n'est lue que par les parties.
cell test E8BrancheC {
    rules {
        mock random_token ["DEFI-C-OPA", "DEFI-C-OPB"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == "injecte"
        let r = Monde.cribler(Monde.h(20827, 3600), ["A2|E1"])[0]
        assert ApiCoordination.repondre(Monde.h(20827, 4000), r, "accepte", "", "", "dyn.a") == "arretee"
        let a2 = Monde.objet("A2")
        let e1 = Monde.objet("E1")
        // propriété 6 : OPA restreint la diffusion de A2 aux parties ; seules les parties (et
        // ORBITE) lisent la désignation
        assert DonDiffusion.declarer(Monde.h(20827, 4100), a2, "parties", "chef.a") == "parties"
        assert ApiCoordination.designe(r, "dyn.a") == a2
        assert ApiCoordination.designe(r, "aut.ald") == a2
        assert ApiCoordination.designe(r, "ana1") == a2
        assert ApiCoordination.designe(r, "systeme") == a2
        assert_fails ApiCoordination.designe(r, "dyn.b") matching "Confidentiel"
        assert_fails ApiCoordination.designe(r, "pf.caz") matching "Confidentiel"
        assert_fails ApiCoordination.designe(r, "capt.1") matching "Confidentiel"
        let d = split(ApiCoordination.decision(r), "|")[0]
        assert d == "DS-{r}-1"
        // collision constatée après le TCA, à quatre yeux
        let t = Monde.h(20828, 66600)
        assert_fails ApiEvenements.declarer(t, "collision", [to_string(a2), to_string(e1)], r, Monde.h(20828, 64800), "perte de contact de A2, nuage de débris", "ana1", "ana2") matching "Habilitation"
        let ev = ApiEvenements.declarer(t, "collision", [to_string(a2), to_string(e1)], r, Monde.h(20828, 64800), "perte de contact de A2, nuage de débris", "ana1", "sup1")
        assert ApiEvenements.existe(ev)
        assert ApiEvenements.genre(ev) == "collision"
        assert ApiConjonctions.etat(r) == "collision"
        assert ApiResponsabilite.sous_gel(r)
        assert ApiResponsabilite.sous_gel(to_string(a2))
        // la décision n'a pas été effacée par la fragmentation des objets ; le balayage clôt
        assert ApiCoordination.decision(r) != ""
        assert ApiCoordination.balayer(Monde.h(20828, 66700), "systeme") >= 1
        assert ApiCoordination.etat(r) == "close"
        // chaîne de preuve de la décision : pièce de coordination, rapprochement, priorités, météo,
        // éphémérides et fiches des deux objets à l'instant de la décision
        assert len(ApiResponsabilite.chaine(d)) == 8
        let ch = ApiResponsabilite.chaine(d)
        assert starts_with(RespPieces.lire(ch[0]), "coordination | {r} | coordination |")
        assert contains(RespPieces.lire(ch[0]), "decision={d}|{a2}|")
        assert Monde.piece_contenant(ch, "ephemeride | {a2} |") != ""
        assert contains(Monde.piece_contenant(ch, "ephemeride | {a2} |"), "depot=EPH-A2-1; empreinte=sha256:")
        assert contains(Monde.piece_contenant(ch, "objet | {a2} |"), "propulsion=impulsionnelle; etat_objet=en_service")
        assert Monde.piece_contenant(ch, "priorites | {r} |") != ""
        assert ApiRef.etat_objet(a2) == "fragmente"
        // une journée d'horloge après la collision (nuage, notifications, gel) : aucun balayage en erreur
        assert Monde.battre_de(Monde.h(20828, 68400), Monde.h(20829, 68400), 3600000) == []
    }
}

// ── 8. Rentrée de l'étage E1 : prévision (rentrée à risque), notification des États (d'office
// ALD, État d'immatriculation et de tutelle ; CAZ survolé), accusé, constat à quatre yeux,
// objet « rentre » au catalogue.
cell test E9Rentree {
    rules {
        mock random_token ["DEFI-C-OPA", "DEFI-C-OPB"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == "injecte"
        let e1 = Monde.objet("E1")
        let c = ApiReentrees.prevoir(Monde.h(20830, 21600), e1, Monde.h(20831, 0), Monde.h(20831, 21600), 150, "ana1")
        assert ApiReentrees.en_campagne(e1)
        assert ApiReentrees.a_risque(e1)
        assert ApiReentrees.campagne_de(e1) == c
        assert ReeNotification.inscrire(Monde.h(20830, 21700), c, ["CAZ"], "survol", "ana1") == 1
        assert ReeNotification.diffuser(Monde.h(20830, 21800), c, "systeme") == 2
        assert ReeNotification.accuser(Monde.h(20830, 25200), "NT-1", "avis à la population", "pf.ald") == "accusee"
        assert_fails ReeNotification.accuser(Monde.h(20830, 25200), "NT-2", "", "pf.ald") matching "Habilitation"
        assert ReeNotification.accuser(Monde.h(20830, 25300), "NT-2", "", "pf.caz") == "accusee"
        // révision : fenêtre rétrécie (13/01 2 h - 4 h), campagne imminente, rediffusée
        assert ApiReentrees.prevoir(Monde.h(20830, 79200), e1, Monde.h(20831, 7200), Monde.h(20831, 14400), 150, "ana1") == c
        assert ReeCampagne.etat(c) == "imminente"
        assert ApiReentrees.fenetre(e1) == "{to_int(Monde.h(20831, 7200))},{to_int(Monde.h(20831, 14400))}"
        // constat à quatre yeux, une fois l'objet perdu par l'observation
        assert_fails ApiReentrees.constater(Monde.h(20831, 28800), e1, Monde.h(20831, 10800), "océan Austral", false, "ana1", "ana1") matching "QuatreYeux"
        assert ApiReentrees.constater(Monde.h(20831, 28800), e1, Monde.h(20831, 10800), "océan Austral", false, "ana1", "sup1") == "rentre"
        assert ApiReentrees.constatee(e1)
        assert ApiRef.etat_objet(e1) == "rentre"
        assert !ApiReentrees.en_campagne(e1)
        assert Monde.battre_de(Monde.h(20831, 32400), Monde.h(20832, 32400), 3600000) == []
        // et l'horloge elle-même (now_ms simulé) : aucun balayage en erreur
        mock now_ms 1799920800000
        assert Horloge.battre() >= 0
        assert Horloge.dernier_battement() == 1799920800000
        assert Journal.chercher("en erreur", 5) == []
    }
}
