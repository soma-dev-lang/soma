// ORBITE COMMUNE — règles de barre en mer (COLREG 1972) appliquées au protocole d'ORBITE, sur les
// VRAIS corps des 20 sous-systèmes (use prod), sans aucune doublure. Modèle : test_aeolus.cell.
// Un test par règle, chacun avec un cas où elle s'applique et un cas où elle ne s'applique pas :
//   C18  règle 18 — le moins manœuvrant a priorité : l'impulsionnelle s'écarte devant la faible ;
//   C3   dernier arrivé — à capacité égale, le lancé le plus récemment s'écarte ;
//   C13  règle 13 — rattrapage : l'objet de l'orbite la plus basse s'écarte ;
//   C8   règle 8 — manœuvre franche (pc résiduelle < 1/1 000 000), à temps, visible ;
//   C17a règle 17a — le privilégié garde son cap ;
//   C17b règle 17b — relève du désigné défaillant par le privilégié (et son contraire) ;
//   C34  règle 34 — avis d'intention au privilégié.
// Tout est SIMULÉ : États ALD, BRV, CAZ ; opérateurs ORG-OPA (tutelle BRV) et ORG-OPB (tutelle CAZ) ;
// objets, dates (jours de 2019, sans lien avec un fait réel), vecteurs, Δv.
//
// Objets : OBJ-1 A-IMP (OPA, impulsionnelle, 1 000 kg) ; OBJ-2 B-FAIB (OPB, faible, 250 kg) ;
// OBJ-3 B-IMP (OPB, impulsionnelle, 500 kg) ; OBJ-4 A-HAB (OPA, station habitée, impulsionnelle) ;
// OBJ-5 DEBRIS (non attribué, sans propulsion) ; lancés le 30/08 par L-C-1 : N-IMP (OPA,
// impulsionnelle, 2 000 kg) et N-FAIB (OPA, faible, 200 kg). Règles PRIO-C : 1 dérogation exempte ;
// 2 dernier arrivé désigné ; 3 masse moindre désignée ; préavis 6 h (impulsionnelle), 72 h (faible).
// Repères : jour 18136 = 28/08, 18138 = 30/08, 18139 = 31/08, 18140 = 01/09, 18141 = 02/09.
use prod

cell Monde {
    on h(j: Int, s: Int) { return Horodatage(j * 86400000 + s * 1000) }
    on t0() { return h(18017, 36000) }

    // 1a. Référentiel, personnes d'ORBITE, États, organisations.
    on fonder() {
        let t = t0()
        let _ = RefOrg.amorcer(t, "ALD", "Aldanie", "systeme")
        let _ = AccesPersonnes.amorcer(t, "dir1")
        let _ = ApiAcces.enregistrer(t, "dir2", "ORG-ORBITE", "direction", "dir1")
        let _ = ApiAcces.enregistrer(t, "sup1", "ORG-ORBITE", "superviseur", "dir1")
        let _ = ApiAcces.enregistrer(t, "conf1", "ORG-ORBITE", "conformite", "dir1")
        let _ = ApiAcces.enregistrer(t, "exp1", "ORG-ORBITE", "exploitant", "dir1")
        let _ = ApiAcces.enregistrer(t, "ana1", "ORG-ORBITE", "analyste", "exp1")
        for e in [["BRV", "Bravie"], ["CAZ", "Cazanie"]] {
            let _ = RefEtat.declarer(t, Etat(e[0]), e[1], "ana1")
            let _ = RefEtat.candidater(t, Etat(e[0]), "INSTR-{e[0]}-1", "sup1")
            let _ = RefEtat.admettre(t, Etat(e[0]), "dir1", "dir2")
        }
        for e in ["ALD", "BRV", "CAZ"] {
            let _ = ApiRef.inscrire_organisation(t, "ORG-{e}", "Autorité de {e}", Etat(e), "etat", "sup1", "dir1")
        }
        let _ = ApiRef.inscrire_organisation(t, "ORG-OPA", "Opérateur A", "BRV", "operateur", "sup1", "dir1")
        let _ = ApiRef.inscrire_organisation(t, "ORG-OPB", "Opérateur B", "CAZ", "operateur", "sup1", "dir1")
        let _ = ApiRef.inscrire_organisation(t, "ORG-CAPT", "Capteurs d'Aldanie", "ALD", "capteur", "sup1", "dir1")
        return "ok"
    }

    // 1b. Personnes des États et des organisations ; rattachements confirmés.
    on personnes() {
        let t = t0()
        for e in ["ald", "brv", "caz"] {
            let org = Org("ORG-{uppercase(e)}")
            let _ = ApiAcces.enregistrer(t, "aut.{e}", org, "autorite", "exp1")
            let _ = AccesRattachements.confirmer(t, "aut.{e}", "NV-{e}-1", "dir1", "sup1")
            let _ = ApiAcces.enregistrer(t, "pf.{e}", org, "point_focal", "exp1")
            let _ = AccesRattachements.confirmer(t, "pf.{e}", "NV-{e}-2", "aut.{e}", "")
        }
        for o in [["a", "ORG-OPA", "brv"], ["b", "ORG-OPB", "caz"]] {
            let adm = "adm.{o[0]}"
            let _ = ApiAcces.enregistrer(t, adm, Org(o[1]), "administrateur_operateur", "exp1")
            let _ = AccesRattachements.confirmer(t, adm, "CONTRAT-{o[0]}", "aut.{o[2]}", "")
            let _ = ApiAcces.enregistrer(t, "dyn.{o[0]}", Org(o[1]), "dynamicien", adm)
            let _ = ApiAcces.enregistrer(t, "dyn.{o[0]}2", Org(o[1]), "dynamicien", adm)
            let _ = ApiAcces.enregistrer(t, "chef.{o[0]}", Org(o[1]), "chef_de_mission", adm)
        }
        let _ = ApiAcces.enregistrer(t, "adm.capt", "ORG-CAPT", "administrateur_operateur", "exp1")
        let _ = AccesRattachements.confirmer(t, "adm.capt", "CONTRAT-CAPT", "aut.ald", "")
        let _ = ApiAcces.enregistrer(t, "capt.1", "ORG-CAPT", "capteur", "adm.capt")
        return "ok"
    }

    // 1c. Accord de partage ADP-1, en vigueur le 30/06.
    on accord() {
        let t = t0()
        let _ = DonAccords.rediger(t, "ADP-1", "sha256:adp1", "première version", "dir1")
        let _ = DonAccords.soumettre(t, "ADP-1", Duree(2592000000), ["ALD", "BRV", "CAZ"], "dir1")
        for e in ["ald", "brv", "caz"] {
            let _ = DonAccords.donner_avis(h(18018, 36000), "ADP-1", Etat(uppercase(e)), "favorable", "aut.{e}")
        }
        let _ = DonAccords.adopter(h(18047, 36000), "ADP-1", h(18077, 36000), "dir1", "dir2")
        let _ = ApiDonnees.balayer(h(18077, 36000), "systeme")
        return DonAccords.en_vigueur()
    }
    on adherer(org: String, par: String) {
        let a = DonAdhesions.signer(h(18078, 36000), Org(org), par)
        return DonAdhesions.contresigner(h(18078, 37000), a, "conf1")
    }

    // 1d. Règles de priorité PRIO-C, en vigueur le 01/08 : 1 dérogation exempte ; 2 dernier
    // arrivé désigné (choix d'Antoine : à capacité égale, le lancé le plus récemment s'écarte) ;
    // 3 masse moindre désignée ; préavis : impulsionnelle 6 h, faible 72 h. Avant la table, les
    // règles câblées : propriétés 2 et 3, règle 18, règle 13.
    on priorites() {
        let t = t0()
        let v = "PRIO-C"
        let _ = PrioVersion.rediger(t, v, "Règles de barre", "", h(18109, 0), "ana1")
        let _ = PrioTable.poser_regle(t, v, 1, "derogation", "exempte", "ana1")
        let _ = PrioTable.poser_regle(t, v, 2, "arrivee_recente", "designe", "ana1")
        let _ = PrioTable.poser_regle(t, v, 3, "masse_moindre", "designe", "ana1")
        let _ = PrioTable.fixer_preavis(t, v, "impulsionnelle", Duree(21600000), "ana1")
        let _ = PrioTable.fixer_preavis(t, v, "faible", Duree(259200000), "ana1")
        let _ = PrioVersion.soumettre(t, v, h(18047, 36000), "ana1", "sup1")
        for e in ["ald", "brv", "caz"] {
            let _ = PrioConsultation.donner_avis(h(18018, 36000), v, Etat(uppercase(e)), "favorable", "", "pf.{e}")
        }
        let _ = ApiPriorites.balayer(h(18047, 36000), "systeme")
        let _ = PrioVersion.mettre_au_vote(h(18048, 36000), v, h(18062, 36000), "sup1", "dir1")
        for e in ["ald", "brv", "caz"] {
            let _ = PrioScrutin.voter(h(18049, 36000), v, Etat(uppercase(e)), "pour", "pf.{e}")
        }
        let _ = ApiPriorites.balayer(h(18062, 36000), "systeme")
        let _ = PrioVersion.publier(h(18063, 36000), v, "sup1")
        let _ = ApiPriorites.balayer(h(18109, 60), "systeme")
        return PrioVersion.etat(v)
    }

    // 1e. Canal webhook vérifié (le test mocke random_token "DEFI-<c>" et http_post).
    on canal(c: String, org: String, adm: String) {
        let t = h(18134, 36000)
        let _ = PasCanaux.declarer(t, c, Org(org), "webhook", "https://{c}.invalid/orbite", adm)
        return PasCanaux.verifier(t, c, "DEFI-{c}", appelant(adm, org, "administrateur_operateur"))
    }
    on appelant(p: String, org: String, role: String) {
        return PasAppelant { personne: p, org: Org(org), role: Role(role) }
    }

    // 1f. Opérateur `x` d'`org` sous la tutelle de `e`, actif le 27/08 8 h 20 (licence, dossier,
    // engagements 24 h / 2 h / 30 min, astreinte dyn.<x> jusqu'au 03/09, exercice, chef de mission).
    on operateur(x: String, org: String, e: String) {
        let t = h(18135, 28800)
        let o = Org(org)
        let adm = "adm.{x}"
        let _ = OpLicences.declarer(t, o, "LIC-{e}-{x}", h(17532, 0), h(19358, 0), adm)
        let _ = OpLicences.repondre_etat(t, o, "confirmee", "aut.{e}")
        let d = OpDossiers.deposer(t, o, "statuts ; licence ; plan d'astreinte", adm)
        let _ = OpDossiers.instruire(t, d, "ana1")
        let _ = OpDossiers.accepter(t, d, "ana1", "sup1")
        let _ = OpEngagements.proposer(t, o, Duree(86400000), Duree(7200000), Duree(1800000), adm)
        let _ = OpEngagements.accepter(t, o, "sup1")
        let s1 = OpAstreinte.planifier(t, o, "dyn.{x}", t, h(18142, 28800), "chef.{x}")
        let _ = OpAstreinte.planifier(t, o, "dyn.{x}2", h(18142, 28800), h(18149, 28800), "chef.{x}")
        let _ = OpAstreinte.prendre_service(t, s1, "dyn.{x}")
        let ex = OpExercices.planifier(t, o, t, "ana1")
        let _ = OpExercices.lancer(t, ex, "ana1")
        let att = PasMessages.en_attente(appelant("dyn.{x}", org, "dynamicien"), 10)
        let msg = split(att[0], " | ")[0]
        let _ = PasMessages.acquitter(h(18135, 29000), msg, appelant("dyn.{x}", org, "dynamicien"))
        let _ = OpExercices.accuser(h(18135, 29100), ex, "dyn.{x}")
        let ct = OpContacts.declarer(t, o, "chef.{x}", "chef_de_mission", 1, "TEL-{x}-1", adm)
        let _ = OpContacts.confirmer(t, ct, "chef.{x}")
        return OpMembres.activer(h(18135, 29200), o, "sup1")
    }
    on points_focaux() {
        let t = h(18135, 28800)
        for e in ["ald", "brv", "caz"] {
            let ct = OpContacts.declarer(t, Org("ORG-{uppercase(e)}"), "pf.{e}", "point_focal", 1, "TEL-PF-{e}", "aut.{e}")
            let _ = OpContacts.confirmer(t, ct, "pf.{e}")
        }
        return "ok"
    }

    // 1g. Fournisseur de capteurs agréé ; CAP-1 radar, CAP-2 optique, CAP-3 laser étalonnés.
    on capteurs() {
        let t = h(18134, 28800)
        let _ = ObsFournisseurs.demander(t, "ORG-CAPT", "adm.capt")
        let _ = ObsFournisseurs.agreer(t, "ORG-CAPT", "exp1", "sup1")
        for g in ["radar", "optique", "laser"] {
            let c = ObsCapteurs.declarer(t, "ORG-CAPT", ObsGenreCapteur(g), ["leo"], Distance(10), "capt.1")
            let _ = ObsCapteurs.etalonner(t, c, "capt.1")
            let _ = ObsCapteurs.valider_etalonnage(t, c, Distance(5), "ana1")
        }
        return "ok"
    }

    on amorcer() {
        let _ = fonder()
        let _ = personnes()
        let _ = accord()
        for a in [["ORG-OPA", "adm.a"], ["ORG-OPB", "adm.b"], ["ORG-ALD", "aut.ald"], ["ORG-BRV", "aut.brv"], ["ORG-CAZ", "aut.caz"]] {
            let _ = adherer(a[0], a[1])
        }
        let _ = priorites()
        let _ = adherer("ORG-CAPT", "adm.capt")
        let _ = capteurs()
        let _ = canal("C-A", "ORG-OPA", "adm.a")
        let _ = canal("C-B", "ORG-OPB", "adm.b")
        let _ = operateur("a", "ORG-OPA", "brv")
        let _ = operateur("b", "ORG-OPB", "caz")
        return points_focaux()
    }

    // 2. Objets catalogués le 27/08 12 h (déjà en orbite à la création du monde), immatriculés,
    // mis en service ; puis le lancement L-C-1 d'OPA le 30/08 (N-IMP, N-FAIB).
    on objet(p: String) {
        if p == "A-IMP" { return Objet("OBJ-1") }
        if p == "B-FAIB" { return Objet("OBJ-2") }
        if p == "B-IMP" { return Objet("OBJ-3") }
        if p == "A-HAB" { return Objet("OBJ-4") }
        if p == "DEBRIS" { return Objet("OBJ-5") }
        return LancPiece.fiche("L-C-1/{p}").objet
    }
    on dynamicien(p: String) {
        if starts_with(p, "B") { return "dyn.b" }
        return "dyn.a"
    }
    on rang(p: String) {
        let noms = ["A-IMP", "B-FAIB", "B-IMP", "A-HAB", "DEBRIS", "N-IMP", "N-FAIB"]
        return index_of(noms, p)
    }
    // Position (m) de l'objet `p` dans le repère commun : une orbite à 6 700 km + 1 km par rang.
    on position(p: String) { return "{6700000 + 1000 * rang(p)},0,0" }
    on cataloguer() {
        let t = h(18135, 43200)
        let a = ApiRef.cataloguer(t, "satellite", "ORG-OPA", "BRV", "leo", "impulsionnelle", Masse(1000), "ana1")
        let bf = ApiRef.cataloguer(t, "satellite", "ORG-OPB", "CAZ", "leo", "faible", Masse(250), "ana1")
        let bi = ApiRef.cataloguer(t, "satellite", "ORG-OPB", "CAZ", "leo", "impulsionnelle", Masse(500), "ana1")
        let st = ApiRef.cataloguer(t, "station_habitee", "ORG-OPA", "BRV", "leo", "impulsionnelle", Masse(400000), "ana1")
        let de = ApiRef.cataloguer(t, "debris", ApiRef.orbite(), "", "leo", "aucune", Masse(50), "ana1")
        for x in [[a, "aut.brv", "dyn.a"], [bf, "aut.caz", "dyn.b"], [bi, "aut.caz", "dyn.b"], [st, "aut.brv", "dyn.a"]] {
            let _ = ApiRef.immatriculer(h(18135, 43300), Objet(x[0]), "REG-{x[0]}", x[1])
            let _ = ApiRef.changer_etat_objet(h(18135, 43400), Objet(x[0]), "en_service", "", "objet en orbite à la création du monde", x[2])
        }
        let _ = EphReglage.amorcer(h(18135, 43500), "exp1")
        return [a, bf, bi, st, de]
    }
    // Lancement L-C-1 d'OPA (État de lancement BRV) : préavis le 27/08 8 h 30 pour la fenêtre du
    // 30/08 10 h-11 h ; COLA, avis favorable ; tir, injection 10 h 20, catalogage à 12 h ;
    // immatriculation et mise en service à 12 h 05.
    on lancement() {
        let l = "L-C-1"
        let t = h(18135, 30600)
        let _ = ApiLancements.notifier(t, l, "ORG-OPA", "BRV", h(18138, 36000), h(18138, 39600), "leo", 2, "chef.a")
        let _ = LancZones.declarer(t, l, ["CAZ|{to_int(h(18138, 36000))}|{to_int(h(18138, 39600))}|Z1|premier_etage"], "chef.a")
        let _ = campagne(h(18135, 30700))
        let _ = LancCola.demander(h(18135, 30900), l, "TRAJ-L1", "dyn.a")
        let _ = LancCola.conclure(h(18135, 31000), l, 1, [], [], "systeme")
        let _ = LancAvis.rediger(h(18135, 31100), l, "favorable", "fenêtre entière sûre", "ana1")
        let _ = LancAvis.valider(h(18135, 31200), l, "ana1", "sup1")
        for p in [["N-IMP", "2000", "impulsionnelle"], ["N-FAIB", "200", "faible"]] {
            let _ = LancPiece.prevoir(h(18135, 31300), l, "{l}/{p[0]}", "charge_utile", "ORG-OPA", "BRV", Masse(to_int(p[1])), Propulsion(p[2]), false, "chef.a")
        }
        let _ = LancLancement.confirmer_tir(h(18138, 36600), l, h(18138, 36300), "chef.a")
        let _ = LancLancement.declarer_injection(h(18138, 37200), l, h(18138, 37200), "nominale", "chef.a")
        let objs = []
        for p in ["N-IMP", "N-FAIB"] {
            let _ = LancPiece.separer(h(18138, 37800), "{l}/{p}", h(18138, 37800), "dyn.a")
            let o = LancPiece.cataloguer(h(18138, 43200), "{l}/{p}", "ana1")
            let _ = ApiRef.immatriculer(h(18138, 43300), o, "REG-{p}", "aut.brv")
            let _ = ApiRef.changer_etat_objet(h(18138, 43400), o, "en_service", "", "mise en service après injection", "dyn.a")
            objs.push(o)
        }
        return objs
    }
    // Le monde au 30/08 12 h 05 : amorcé, cinq objets catalogués, deux lancés.
    on pret() {
        let _ = amorcer()
        let objs = cataloguer()
        let lances = lancement()
        return len(objs) + len(lances)
    }

    // Éphéméride de `p` déposée à `t` (époque t, horizon 72 h), `poussee` : inclut la poussée planifiée.
    on ephemeride(p: String, t: Horodatage, n: String, poussee: Bool) {
        return ephemeride_en(p, t, t, n, poussee, position(p))
    }
    on ephemeride_en(p: String, t: Horodatage, ep: Horodatage, n: String, poussee: Bool, pos: String) {
        let d = ApiEphemerides.deposer(t, objet(p), "EPH-{p}-{n}", ep, Duree(259200000), "haute", "sha256:" + sha256("{p}-{n}"), pos, poussee, dynamicien(p))
        if ApiEphemerides.depot_valide(d) { return "validee" }
        return "rejetee"
    }
    // Campagne de criblage du régime leo à `t` (moteur externe : le test), terminée.
    on campagne(t: Horodatage) {
        let c0 = en_cours_sur("leo")
        if c0 != "" { return ConjCampagne.terminer(t, c0, 7, 1, 1, "systeme") }
        let c = ConjCampagne.planifier(t, "regime", "leo", "", "manuel", "ana1")
        let _ = ConjCampagne.demarrer(t, c, "systeme")
        return ConjCampagne.terminer(Horodatage(to_int(t) + 60000), c, 7, 1, 1, "systeme")
    }
    on en_cours_sur(reg: String) {
        let l = Journal.chercher("planifiée (regime, {reg}", 1)
        if len(l) == 0 { return "" }
        let c = split(split(l[0], "campagne ")[1], " ")[0]
        if ConjCampagne.etat(c) == "en_cours" { return c }
        return ""
    }
    // Rapprochement a / b remis par le moteur de criblage à `t` (TCA `tca`, distance m, pc).
    on signaler(a: String, b: String, t: Horodatage, tca: Horodatage, distance: Int, pc: Int) {
        let _ = campagne(t)
        return ApiConjonctions.signaler(Horodatage(to_int(t) + 120000), objet(a), objet(b), tca, Distance(distance), Probabilite(pc), "systeme")
    }
    // Alerte : 150 m, pc 1/1 000 — la coordination s'ouvre et propose la désignation des règles.
    on alerte(a: String, b: String, t: Horodatage, tca: Horodatage) {
        return signaler(a, b, t, tca, 150, 1000000)
    }
    // Les parties acceptent la proposition à `t` (accord des deux propriétaires : verrou posé).
    on accepter(r: Rapprochement, t: Horodatage) {
        for p in ["dyn.a", "dyn.b"] {
            let _ = try { ApiCoordination.repondre(t, r, "accepte", "", "", p) }
        }
        return ApiCoordination.etat(r)
    }
    // Motif appliqué de la dernière décision de priorité de `r` (4e champ de decision_de).
    on motif(r: Rapprochement) {
        let d = split(ApiPriorites.decision_de(r), "|")
        if len(d) < 4 { return "" }
        return d[3]
    }
    // Plan `nom` de `p` déclaré à `t` (campagne fraîche à t − 10 min, éphéméride avec la poussée à
    // t − 5 min) ; `r` "" et motif autre qu'évitement pour un plan hors coordination.
    on plan(p: String, nom: String, r: Rapprochement, motif_p: String, t: Horodatage, debut: Horodatage, dv: Int) {
        let _ = campagne(Horodatage(to_int(t) - 600000))
        let _ = ephemeride(p, Horodatage(to_int(t) - 300000), nom, true)
        return ApiManoeuvres.declarer(t, nom, objet(p), r, motif_p, debut, DeltaV(dv), dynamicien(p))
    }
    // Orbite observée de `p` à l'époque `ep` (six mesures de CAP-1 et CAP-3, corrélées), vecteur
    // `vec` (m, mm/s), périgée et apogée (m), validée contre la dernière éphéméride avec l'écart `ecart`.
    on orbite(p: String, ep: Horodatage, vec: String, per: Int, apo: Int, ecart: Int, k0: Int) {
        let o = objet(p)
        let ms = []
        for k in range(0, 6) {
            let c = if k % 2 == 0 { "CAP-1" } else { "CAP-3" }
            let inst = Horodatage(to_int(ep) - 300000 + k * 30000)
            let m = ApiObservation.deposer_mesure(Horodatage(to_int(ep) + 30000), c, o, inst, "TDM {c} {p} {k0 + k}", "capt.1")
            let _ = ObsMesures.correler(Horodatage(to_int(ep) + 40000), m, o, Distance(5), "ana1")
            ms.push(m)
        }
        let od = ObsOrbites.calculer(Horodatage(to_int(ep) + 50000), to_string(o), ep, ms, Distance(20), vec, Distance(per), Distance(apo), "ana1")
        return ObsOrbites.valider(Horodatage(to_int(ep) + 60000), od, ApiEphemerides.derniere(o), Distance(ecart), "ana1")
    }

    // Horloge : les vingt balayages de Horloge.battre à `t`, par "systeme" ; erreurs rendues.
    on battre(t: Horodatage) {
        let erreurs_b = []
        let r1 = try { ApiRef.balayer(t, "systeme") }
        if r1.error != () { erreurs_b.push("ApiRef: {r1.error}") }
        let r2 = try { ApiAcces.balayer(t, "systeme") }
        if r2.error != () { erreurs_b.push("ApiAcces: {r2.error}") }
        let r3 = try { ApiOperateurs.balayer(t, "systeme") }
        if r3.error != () { erreurs_b.push("ApiOperateurs: {r3.error}") }
        let r4 = try { ApiMeteo.balayer(t, "systeme") }
        if r4.error != () { erreurs_b.push("ApiMeteo: {r4.error}") }
        let r5 = try { ApiObservation.balayer(t, "systeme") }
        if r5.error != () { erreurs_b.push("ApiObservation: {r5.error}") }
        let r6 = try { ApiEphemerides.balayer(t, "systeme") }
        if r6.error != () { erreurs_b.push("ApiEphemerides: {r6.error}") }
        let r7 = try { ApiConjonctions.balayer(t, "systeme") }
        if r7.error != () { erreurs_b.push("ApiConjonctions: {r7.error}") }
        let r8 = try { ApiPriorites.balayer(t, "systeme") }
        if r8.error != () { erreurs_b.push("ApiPriorites: {r8.error}") }
        let r9 = try { ApiCoordination.balayer(t, "systeme") }
        if r9.error != () { erreurs_b.push("ApiCoordination: {r9.error}") }
        let r10 = try { ApiManoeuvres.balayer(t, "systeme") }
        if r10.error != () { erreurs_b.push("ApiManoeuvres: {r10.error}") }
        let r11 = try { ApiEscalade.balayer(t, "systeme") }
        if r11.error != () { erreurs_b.push("ApiEscalade: {r11.error}") }
        let r12 = try { ApiReentrees.balayer(t, "systeme") }
        if r12.error != () { erreurs_b.push("ApiReentrees: {r12.error}") }
        let r13 = try { ApiLancements.balayer(t, "systeme") }
        if r13.error != () { erreurs_b.push("ApiLancements: {r13.error}") }
        let r14 = try { ApiFinDeVie.balayer(t, "systeme") }
        if r14.error != () { erreurs_b.push("ApiFinDeVie: {r14.error}") }
        let r15 = try { ApiEvenements.balayer(t, "systeme") }
        if r15.error != () { erreurs_b.push("ApiEvenements: {r15.error}") }
        let r16 = try { ApiResponsabilite.balayer(t, "systeme") }
        if r16.error != () { erreurs_b.push("ApiResponsabilite: {r16.error}") }
        let r17 = try { ApiDonnees.balayer(t, "systeme") }
        if r17.error != () { erreurs_b.push("ApiDonnees: {r17.error}") }
        let r18 = try { ApiConformite.balayer(t, "systeme") }
        if r18.error != () { erreurs_b.push("ApiConformite: {r18.error}") }
        let r19 = try { ApiPasserelle.balayer(t, "systeme") }
        if r19.error != () { erreurs_b.push("ApiPasserelle: {r19.error}") }
        let r20 = try { ApiOperations.balayer(t, "systeme") }
        if r20.error != () { erreurs_b.push("ApiOperations: {r20.error}") }
        return erreurs_b
    }
    // Le moteur de criblage termine les campagnes de cadence que la ronde vient de lancer.
    on moteur(t: Horodatage) {
        for reg in ["leo", "meo", "geo", "heo"] {
            let c = en_cours_sur(reg)
            if c != "" {
                let k = if reg == "leo" { 7 } else { 0 }
                let p = if reg == "leo" { 1 } else { 0 }
                let _ = ConjCampagne.terminer(t, c, k, p, p, "systeme")
            }
        }
        return "ok"
    }
    // Les deux opérateurs, joignables, acquittent à chaque battement ce qu'ORBITE leur a livré.
    on acquitter_tout(t: Horodatage) {
        let n = 0
        for x in [["dyn.a", "ORG-OPA"], ["dyn.b", "ORG-OPB"]] {
            let qui = appelant(x[0], x[1], "dynamicien")
            for m in PasMessages.en_attente(qui, 100) {
                let a = try { PasMessages.acquitter(t, split(m, " | ")[0], qui) }
                if a.error == () { n = n + 1 }
            }
        }
        return n
    }
    // Flux simulé : éphémérides automatiques de `ps` (avec la poussée si un plan est actif) et une
    // mesure de chaque capteur (le réseau n'est pas muet).
    on flux(t: Horodatage, ps: List<String>) {
        for p in ps {
            let _ = ephemeride(p, t, "F{to_int(t)}", ApiManoeuvres.plan_actif(objet(p)))
        }
        for c in ["CAP-1", "CAP-2", "CAP-3"] {
            let o = objet("A-IMP")
            let m = ApiObservation.deposer_mesure(t, c, o, Horodatage(to_int(t) - 60000), "TDM {c} veille {to_int(t)}", "capt.1")
            let _ = ObsMesures.correler(t, m, o, Distance(5), "ana1")
        }
        return "ok"
    }
    // "JJ/MM HHhMM" (UTC) d'un horodatage d'août-septembre 2019.
    on lisible(t: Int) {
        let j = to_int(t / 86400000)
        let m = to_int((t % 86400000) / 60000)
        let jour = if j >= 18140 { "{pad_left(to_string(j - 18139), 2, \"0\")}/09" } else { "{j - 18108}/08" }
        return "{jour} {pad_left(to_string(to_int(m / 60)), 2, \"0\")}h{pad_left(to_string(m % 60), 2, \"0\")}"
    }
    // Battements de `debut` à `fin` tous les `pas` ms (flux toutes les 6 h). Trace de la
    // désignation de `r` à chaque changement : "JJ/MM HHhMM designe=<o> privilegie=<o> decision=<d>" ;
    // à CHAQUE battement, la propriété 1 est contrôlée — un seul désigné, distinct du privilégié,
    // et au plus un plan d'évitement de r approuvé ou exécuté — toute violation est tracée
    // ("VIOLATION …"), comme toute erreur de balayage.
    on veiller(r: Rapprochement, ps: List<String>, debut: Horodatage, fin: Horodatage, pas: Int) {
        let trace_v = []
        let avant = ""
        let t = to_int(debut)
        while t <= to_int(fin) {
            if (t - to_int(debut)) % 21600000 == 0 { let _ = flux(Horodatage(t), ps) }
            for e in battre(Horodatage(t)) { trace_v.push("{t}: {e}") }
            let _ = moteur(Horodatage(t))
            let _ = acquitter_tout(Horodatage(t))
            let des = ApiCoordination.designe(r, "systeme")
            let pri = ApiCoordination.privilegie(r, "systeme")
            let dec = split(ApiCoordination.decision(r), "|")[0]
            let actifs = 0
            for p in ps {
                for pl in ApiManoeuvres.plans_de(objet(p), Horodatage(0)) {
                    let e = ApiManoeuvres.etat(pl)
                    if ApiManoeuvres.motif_de(pl) == "evitement" && (e == "approuve" || e == "execute") { actifs = actifs + 1 }
                }
            }
            if ApiCoordination.arretee(r) && (des == "" || des == pri) { trace_v.push("VIOLATION {lisible(t)} designe={des} privilegie={pri}") }
            if actifs > 1 { trace_v.push("VIOLATION {lisible(t)} {actifs} évitements approuvés") }
            let ici = "designe={des} privilegie={pri} decision={dec}"
            if ici != avant {
                trace_v.push("{lisible(t)} {ici}")
                avant = ici
            }
            t = t + pas
        }
        return trace_v
    }
} // fin Monde

// ── C0. Le monde : ORBITE amorcée, deux opérateurs actifs, sept objets, dont deux lancés le 30/08.
cell test C0Monde {
    rules {
        mock random_token ["DEFI-C-A", "DEFI-C-B"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == 7
        assert PrioVersion.version_courante() == "PRIO-C"
        assert PrioTable.regles("PRIO-C") == ["1 | derogation | exempte", "2 | arrivee_recente | designe", "3 | masse_moindre | designe"]
        assert ApiOperateurs.est_actif("ORG-OPA", Monde.h(18139, 0))
        assert ApiOperateurs.est_actif("ORG-OPB", Monde.h(18139, 0))
        assert ApiRef.propulsion(Monde.objet("B-FAIB")) == "faible"
        assert ApiRef.habite(Monde.objet("A-HAB"))
        assert !ApiRef.peut_manoeuvrer(Monde.objet("DEBRIS"))
        assert ApiRef.peut_manoeuvrer(Monde.objet("N-IMP"))
        assert ApiRef.peut_manoeuvrer(Monde.objet("N-FAIB"))
        // les lancés du 30/08 sont les derniers arrivés ; les objets d'avant n'ont pas d'injection connue
        assert ApiLancements.injecte_le(Monde.objet("N-IMP")) == Monde.h(18138, 37200)
        assert ApiLancements.injecte_le(Monde.objet("A-IMP")) == 0
    }
}

// ── C18. Règle 18 — le moins manœuvrant a priorité : entre une propulsion faible et une
// impulsionnelle, l'impulsionnelle s'écarte (que la faible tienne ou non son préavis). Ne
// s'applique pas entre deux objets de même capacité, ni contre la propriété 3 (habité), ni à un
// objet sans propulsion (jamais désigné).
cell test C18Manoeuvrabilite {
    rules {
        mock random_token ["DEFI-C-A", "DEFI-C-B"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == 7
        let a = Monde.objet("A-IMP")
        let bf = Monde.objet("B-FAIB")
        // TCA à 4 jours : la faible tiendrait son préavis de 72 h ; l'impulsionnelle s'écarte
        let r1 = Monde.alerte("A-IMP", "B-FAIB", Monde.h(18139, 0), Monde.h(18143, 0))
        assert ApiCoordination.etat(r1) == "proposee"
        assert Monde.motif(r1) == "manoeuvrabilite"
        assert CoordDossier.proposition(r1) == a
        // deux rôles à la pose du verrou : le désigné (give-way) et le privilégié (stand-on)
        assert Monde.accepter(r1, Monde.h(18139, 600)) == "arretee"
        assert ApiCoordination.designe(r1, "dyn.b") == a
        assert ApiCoordination.privilegie(r1, "dyn.b") == bf
        assert ApiCoordination.privilegie(r1, "ana1") == bf
        assert len(Journal.chercher("verrou {r1} posé : décision DS-{r1}-1, désigné '{a}', mode accord, valideur '', privilégié '{bf}'", 5)) == 1
        // TCA à 48 h : la faible ne tient plus ; toujours la règle 18
        let r2 = Monde.alerte("A-IMP", "B-FAIB", Monde.h(18139, 3600), Monde.h(18141, 3600))
        assert Monde.motif(r2) == "manoeuvrabilite"
        assert CoordDossier.proposition(r2) == a
        // ne s'applique pas : deux impulsionnelles (même capacité) — la table tranche (masse)
        let r3 = Monde.alerte("A-IMP", "B-IMP", Monde.h(18139, 7200), Monde.h(18143, 7200))
        assert Monde.motif(r3) == "regle:3"
        assert CoordDossier.proposition(r3) == Monde.objet("B-IMP")
        // ne s'applique pas : une station habitée (impulsionnelle) face à la faible — propriété 3
        let r4 = Monde.alerte("A-HAB", "B-FAIB", Monde.h(18139, 10800), Monde.h(18143, 10800))
        assert Monde.motif(r4) == "habite_exempte"
        assert CoordDossier.proposition(r4) == bf
        // un objet sans propulsion n'est jamais désigné : la faible, seule capable
        let r5 = Monde.alerte("DEBRIS", "B-FAIB", Monde.h(18139, 14400), Monde.h(18143, 14400))
        assert Monde.motif(r5) == "seul_capable"
        assert CoordDossier.proposition(r5) == bf
    }
}

// ── C3. Dernier arrivé (choix d'Antoine) : à capacité égale, le lancé le plus récemment s'écarte
// (critère "arrivee_recente", rang 2 de la table). Ne s'applique qu'à capacité égale.
cell test C3DernierArrive {
    rules {
        mock random_token ["DEFI-C-A", "DEFI-C-B"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == 7
        let ni = Monde.objet("N-IMP")
        let bi = Monde.objet("B-IMP")
        // N-IMP (lancé le 30/08, 2 000 kg) face à B-IMP (500 kg, déjà en orbite) : le dernier arrivé
        // s'écarte, avant la masse (qui aurait désigné B-IMP)
        let r1 = Monde.alerte("N-IMP", "B-IMP", Monde.h(18139, 0), Monde.h(18143, 0))
        assert Monde.motif(r1) == "regle:2"
        assert CoordDossier.proposition(r1) == ni
        // ne s'applique pas : le dernier arrivé est une propulsion faible — la règle 18 passe avant
        let r2 = Monde.alerte("N-FAIB", "B-IMP", Monde.h(18139, 3600), Monde.h(18143, 3600))
        assert Monde.motif(r2) == "manoeuvrabilite"
        assert CoordDossier.proposition(r2) == bi
        // ne s'applique pas : aucune injection connue des deux côtés — la masse tranche
        let r3 = Monde.alerte("A-IMP", "B-IMP", Monde.h(18139, 7200), Monde.h(18143, 7200))
        assert Monde.motif(r3) == "regle:3"
        assert CoordDossier.proposition(r3) == bi
    }
}

// ── C13. Règle 13 — rattrapage : vitesse relative au TCA < 100 m/s (orbites voisines quasi
// coplanaires), l'objet de l'orbite la plus basse (le plus rapide) s'écarte. Après la règle 18,
// avant le dernier arrivé et la table ; sans géométrie ni orbites observées, ne s'applique pas.
cell test C13Rattrapage {
    rules {
        mock random_token ["DEFI-C-A", "DEFI-C-B"]
        mock http_post ["ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]
        assert Monde.pret() == 7
        let a = Monde.objet("A-IMP")
        let bi = Monde.objet("B-IMP")
        let t = Monde.h(18139, 0)
        assert Monde.ephemeride("A-IMP", t, "0", false) == "validee"
        assert Monde.ephemeride("B-IMP", t, "0", false) == "validee"
        assert Monde.ephemeride("B-FAIB", t, "0", false) == "validee"
        // orbites observées : A-IMP à 400 km, B-IMP à 420 km, B-FAIB à 380 km
        assert Monde.orbite("A-IMP", Monde.h(18139, 600), "6700000,0,0,0,7700000,0", 400000, 400000, 0, 0) != ""
        assert Monde.orbite("B-IMP", Monde.h(18139, 600), "6702000,0,0,0,7700000,0", 420000, 420000, 0, 10) != ""
        assert Monde.orbite("B-FAIB", Monde.h(18139, 600), "6701000,0,0,0,7700000,0", 380000, 380000, 0, 20) != ""
        assert ApiObservation.perigee(a) == 400000
        // rapprochement A-IMP / B-IMP signalé au niveau 1 ; le moteur précise la géométrie
        let tca1 = Monde.h(18143, 0)
        let r1 = Monde.signaler("A-IMP", "B-IMP", Monde.h(18139, 1200), tca1, 4000, 100)
        assert ApiConjonctions.niveau(r1) == 1
        assert ApiConjonctions.vitesse_relative(r1) == 0
        assert !ApiConjonctions.en_rattrapage(r1)
        assert_fails ApiConjonctions.preciser_geometrie(Monde.h(18139, 1500), r1, 0, "systeme") matching "HorsBornes"
        assert_fails ApiConjonctions.preciser_geometrie(Monde.h(18139, 1500), r1, 25000, "systeme") matching "HorsBornes"
        assert_fails ApiConjonctions.preciser_geometrie(Monde.h(18139, 1500), r1, 50, "dyn.a") matching "Habilitation"
        assert_fails ApiConjonctions.preciser_geometrie(Monde.h(18139, 1500), "CJ-999", 50, "systeme") matching "Inconnu"
        assert ApiConjonctions.preciser_geometrie(Monde.h(18139, 1500), r1, 50, "systeme") == 50
        assert ApiConjonctions.vitesse_relative(r1) == 50
        assert ApiConjonctions.en_rattrapage(r1)
        // l'alerte arrive : A-IMP, plus bas (et plus lourd : la masse aurait désigné B-IMP), s'écarte
        assert Monde.alerte("A-IMP", "B-IMP", Monde.h(18139, 1800), tca1) == r1
        assert Monde.motif(r1) == "rattrapage"
        assert CoordDossier.proposition(r1) == a
        let d1 = split(ApiPriorites.decision_de(r1), "|")[0]
        assert PrioDesignation.rejouer(d1) == a
        // ne s'applique pas : vitesse relative de croisement (7 km/s)
        let tca2 = Monde.h(18143, 7200)
        let r2 = Monde.signaler("A-IMP", "B-IMP", Monde.h(18139, 2400), tca2, 4000, 100)
        assert ApiConjonctions.preciser_geometrie(Monde.h(18139, 2700), r2, 7000, "systeme") == 7000
        assert !ApiConjonctions.en_rattrapage(r2)
        assert Monde.alerte("A-IMP", "B-IMP", Monde.h(18139, 3000), tca2) == r2
        assert Monde.motif(r2) == "regle:3"
        assert CoordDossier.proposition(r2) == bi
        // ne s'applique pas : aucune géométrie remise
        let r3 = Monde.alerte("A-IMP", "B-IMP", Monde.h(18139, 3600), Monde.h(18143, 14400))
        assert Monde.motif(r3) == "regle:3"
        // ne s'applique pas avant la règle 18 : B-FAIB, plus basse, ne s'écarte pas devant A-IMP
        let tca4 = Monde.h(18143, 21600)
        let r4 = Monde.signaler("A-IMP", "B-FAIB", Monde.h(18139, 4200), tca4, 4000, 100)
        assert ApiConjonctions.preciser_geometrie(Monde.h(18139, 4500), r4, 50, "systeme") == 50
        assert Monde.alerte("A-IMP", "B-FAIB", Monde.h(18139, 4800), tca4) == r4
        assert Monde.motif(r4) == "manoeuvrabilite"
        assert CoordDossier.proposition(r4) == a
    }
}

// ── C8. Règle 8 — manœuvre franche, à temps, visible : un plan d'évitement n'est approuvé que si
// son criblage ramène la pc du rapprochement sous 1/1 000 000, avant la limite d'action, sur une
