// 033: Guard conditions — a transition that only fires when its guard holds.
//
// A guard is evaluated when a handler calls transition(). It sees the locals
// of THAT handler, the cell's memory slots, and _id / _from / _to. `soma
// check` verifies that every name a guard reads is bound by the handler that
// takes the transition; the guard itself is enforced at runtime.
cell GuardState {
    face {
        signal submit(id: String, content: String) -> String
        signal approve_doc(id: String, role: String) -> String
        signal run() -> String
    }
    state review {
        initial: draft
        draft -> submitted {
            guard { content != "" }
        }
        submitted -> approved {
            guard { role == "admin" }
        }
        approved -> published
        * -> rejected
    }
    on submit(id: String, content: String) {
        transition(id, "submitted")          // guard reads this handler's `content`
        return get_status(id)
    }
    on approve_doc(id: String, role: String) {
        transition(id, "approved")           // guard reads this handler's `role`
        return get_status(id)
    }
    on run() {
        print("submit with text:", submit("doc", "hello"))
        let r = try { approve_doc("doc", "guest") }
        print("guest approval refused:", r.error != ())
        print("admin approval:", approve_doc("doc", "admin"))
        return "done"
    }
}

cell test GuardTests {
    rules {
        assert_fails submit("empty", "")
        assert submit("d1", "text") == "submitted"
        assert_fails approve_doc("d1", "guest")
        assert approve_doc("d1", "admin") == "approved"
    }
}
