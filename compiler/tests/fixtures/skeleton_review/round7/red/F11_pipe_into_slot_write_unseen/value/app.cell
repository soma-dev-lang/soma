cell A {
    memory {
        c: Map<String, Int>
        invariant c >= 0
    }
    on w(k: String, x: Int) { k |> c.set(x)
 return 1 }
    on probe() {
        let r = try { w("k", 0 - 5) }
        return r.kind ?? "ok"
    }
}
cell test T {
    rules {
        assert A.probe() == "invariant"
    }
}
