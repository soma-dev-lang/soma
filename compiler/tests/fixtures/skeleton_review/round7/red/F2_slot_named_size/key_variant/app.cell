cell A {
    memory {
        c: Map<String, Int>
        key: Map<Int, Int>
        invariant c >= 0
        invariant key >= 0
    }
    on w(k: String, x: Int) { key.set(1, x)
 c.set(k, key.get(1) ?? 0) return 1 }
    on probe() {
        let r = try { w("k", 0 - 5) }
        print(r.error)
        return r.kind ?? "ok"
    }
}
cell test T {
    rules {
        assert A.probe() == "invariant"
    }
}
