cell A {
    memory {
        c: Map<String, Int>
        size: Map<String, Int>
        invariant c >= 0
        invariant size >= 0
    }
    on w(k: String, x: Int) { size.set(k, x)
 c.set(k, size.get(k) ?? 0) return 1 }
    on probe() {
        let r = try { w("k", 0 - 5) }
        print(r)
        return r.kind ?? "ok"
    }
}
cell test T {
    rules {
        assert A.probe() == "invariant"
    }
}
