cell A {
    memory {
        c: Map<String, Int>
        d: Map<String, Int>
        invariant c >= 0
    }
    on w(k: String, x: Int) { let v = 5
 let u = match 1 { _ -> { let v = x
 v } }
 c.set(k, u) return 1 }
    on probe() {
        let r = try { w("k", 0 - 5) }
        print(r.error)
        return r.kind ?? "ok"
    }
}
cell test T {
    rules {
        assert A.probe() == "invariant"
    }
}
