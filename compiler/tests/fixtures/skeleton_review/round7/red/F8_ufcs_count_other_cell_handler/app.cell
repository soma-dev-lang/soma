cell B { on count(v: Float) { return v } }
cell A {
    memory {
        c: Map<String, Float>
        invariant c <= 9
    }
    on w(k: String, x: Float) { let y = x.count()
 require y < 10 else B
 c.set(k, y) return 1 }
    on probe() {
        let r = try { w("k", 9.5) }
        print(r)
        return r.kind ?? "ok"
    }
}
cell test T {
    rules {
        assert A.probe() == "invariant"
    }
}
