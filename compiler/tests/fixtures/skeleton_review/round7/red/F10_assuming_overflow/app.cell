cell Approval {
    state appr {
        initial: pending
        pending -> signed_off
    }
    on sign(id: String) { transition(id, "pending", "signed_off")  return 1 }
    on status(id: String) { return get_status(id) ?? "pending" }
}
cell Pay {
    state pay {
        initial: due
        due -> paid { guard { amount < 5000000000000000000 } }
        due -> ready
        ready -> paid
    }
    on pay(id: String, amount: Int) { transition(id, "due", "paid")  return 1 }
    on open(id: String) { transition(id, "due", "ready") return 1 }
    on fin(id: String) { require Approval.status(id) == "signed_off" else No
        transition(id, "ready", "paid") return 1 }
    on pst(id: String) { return get_status(id) ?? "due" }
}
cell test T {
    rules {
        assert Pay.pay("k", 4700000000000000000) == 1
        assert Pay.pst("k") == "paid"
        assert Approval.status("k") == "pending"
    }
}
