cell Inner {
            memory { c: Map<String, String> [persistent]  }
            state m { initial: a
                a -> b
                b -> z }
            on put(k: String, n: Int) { c.set(k, "{n}") return 1 }
            on look(k: String) { return c.get(k) }
            on go(k: String) { transition(k, "a", "b") return 1 }
            on go2(k: String) { transition(k, "b", "z") return 1 }
            on st(k: String) { return get_status(k) ?? "a" }
}
