use lib::desk

flesh Desk {
    on open(id, title) {
        require titles.get(id) == () else Taken "ticket '{id}' exists"
        titles.set(id, title)
        opened.set("n", count() + 1)
        return map("id", id, "title", title, "state", "new")
    }

    on assign(id, owner) {
        _must_exist(id)
        transition(id, "new", "assigned")
        owners.set(id, owner)
        return owner
    }

    on resolve(id, by) {
        _must_exist(id)
        require owners.get(id) == by else Forbidden "only its owner resolves a ticket"
        transition(id, "assigned", "resolved")
        return "resolved"
    }

    on reopen(id) {
        transition(id, "resolved", "assigned")
        return "assigned"
    }

    on close(id) {
        _must_exist(id)
        transition(id, "closed")
        return "closed"
    }

    on summary(id) {
        _must_exist(id)
        return map("id", id, "title", titles.get(id), "owner", owners.get(id) ?? "nobody", "state", get_status(id) ?? "new")
    }

    on count() {
        return opened.get("n") ?? 0
    }

    // a private helper: `_name`, typed. What it reads counts against every
    // signal that calls it: each of them has `titles` in its frame — leave
    // it out of one and `soma check` names that signal and the clause.
    on _must_exist(id: String) {
        require titles.get(id) != () else NotFound "no ticket '{id}'"
    }
}

cell test DeskTests {
    rules {
        assert open("t1", "printer on fire").state == "new"
        assert count() == 1
        assert_fails open("t1", "again") matching "Taken"
        assert assign("t1", "ines") == "ines"
        assert_fails resolve("t1", "omar") matching "Forbidden"
        assert resolve("t1", "ines") == "resolved"
        assert reopen("t1") == "assigned"
        assert resolve("t1", "ines") == "resolved"
        assert close("t1") == "closed"
        assert_fails reopen("t1")                   // closed is terminal
        assert summary("t1").owner == "ines"
        assert_fails summary("nope") matching "NotFound"

        assert open("t2", "spam").state == "new"
        assert close("t2") == "closed"              // straight from new
        assert count() == 2
    }
}
