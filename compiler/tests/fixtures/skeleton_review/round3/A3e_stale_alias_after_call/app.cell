skeleton Q {
    state fl {
        initial: a
        a -> b
        a -> x
        b -> x
    }
    face {
        signal st(id: String) -> String   reads fl
        signal ab(id: String) -> Int      moves a -> b
        signal mv(id: String) -> Int      moves a -> x  calls ab
    }
}
flesh Q {
    on st(id) { return get_status(id) ?? "a" }
    on ab(id) { transition(id, "a", "b")  return 1 }
    on mv(id) {
        let s = get_status(id) ?? "a"
        let r = ab(id)
        if s == "a" { transition(id, "x") }     // check a -> x, run b -> x
        return 1
    }
}
cell test T {
    rules {
        assert Q.mv("k") == 1
        assert Q.st("k") == "x"
    }
}
