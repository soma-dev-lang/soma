skeleton Q {
    state fl {
        initial: a
        a -> b
        a -> x
        b -> x
    }
    face {
        signal st(id: String) -> String   reads fl
        signal ab(id: String) -> Int      moves a -> b
        signal mv(id: String) -> Int      moves b -> x  calls ab
    }
}
flesh Q {
    on st(id) { return get_status(id) ?? "a" }
    on ab(id) { transition(id, "a", "b")  return 1 }
    on mv(id) {
        let ids = [id, "other"]  let i = 0
        if (get_status(ids[i]) ?? "a") != "b" { return 0 }
        i = i + 1
        transition(ids[i], "x")          // check: b -> x.  run: a -> x
        return 1
    }
}
cell test T {
    rules {
        assert Q.ab("k") == 1
        assert Q.mv("k") == 1
        assert Q.st("other") == "x"
    }
}
