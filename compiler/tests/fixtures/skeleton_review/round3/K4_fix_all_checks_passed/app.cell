cell type Item { variants { Item { sku: String, qty: Int } } }
cell type Order { variants { Order { id: String, item: Item } } }
skeleton Bank {
    memory { acct: Map<String, Int> [persistent] }
    state order {
        initial: new
        new -> paid
        new -> void
        paid -> void
    }
    face {
        signal put(o: Order) -> Int        writes acct
        signal pay(id: String) -> String   moves new -> paid, new -> void
        signal st(id: String) -> String    reads order
    }
}
skeleton Ship {
    state parcel {
        initial: packed
        packed -> paid
        packed -> sent
    }
    face {
        signal send(id: String) -> String  moves packed -> sent
    }
}
flesh Bank {
    on pay(id) { transition(id, "new", "void")  return "paid" }
    on st(id) { return get_status(id) ?? "new" }
}
cell test T { rules { assert Bank.pay("k") == "paid"  assert Bank.st("k") == "paid" } }
