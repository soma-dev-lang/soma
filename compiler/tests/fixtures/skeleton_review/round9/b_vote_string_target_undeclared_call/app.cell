cell B {
    memory { hits: Map<String, Int> }
    on bump(x: Int) { hits.set("h", 1)  return 7 }
    on seen() { return hits.get("h") ?? 0 }
}
skeleton A {
    face {
        signal go() -> Int      calls vote
        signal fan() -> Int     calls horde
    }
}
flesh A {
    on go() { let r = vote("B.bump", 1, 1)
 return 1 }
    on fan() { let r = horde("B.bump", [1])
 return 1 }
}
cell test T {
    rules {
        let r = try { A.go() }
        assert B.seen() == 0
    }
}
