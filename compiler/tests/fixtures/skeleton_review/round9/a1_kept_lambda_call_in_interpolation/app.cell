cell Visit {
    memory { log: Map<String, String> }
    state v {
        initial: waiting
        waiting -> open
        open -> done
        done -> open
    }
    on open_visit(id: String) { transition(id, "waiting", "open")  log.set(id, Desk.st(id))  return "open" }
    on close_visit(id: String) { transition(id, "open", "done")  return "done" }
    on reopen(id: String) { transition(id, "done", "open")  return "open" }
    on status(id: String) { return get_status(id) ?? "waiting" }
    on seen(id: String) { return log.get(id) ?? "-" }
    on open5() { transition(5, "waiting", "open")  return 1 }
}
cell Desk {

    state d {
        initial: none
        none -> requested
    }
    on st(id: String) { return get_status(id) ?? "none" }
    on dbg(id: String) { let r = try { go(id) }
        return r }
    on go(id: String) {
        let f = x => "{Visit.close_visit(x)}"
        require Visit.status(id) == "open" else No
        let q = f(id)
        transition(id, "none", "requested")
        return 1
    }
}
cell test T {
    rules {
        let a = Visit.open_visit("k")
        let r = try { Desk.go("k") }
        assert Desk.st("k") == "requested"
        assert Visit.status("k") != "open"
    }
}
