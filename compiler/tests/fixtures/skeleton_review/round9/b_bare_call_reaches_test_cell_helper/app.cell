cell B {
    memory { hits: Map<String, Int> }
    on bump(v: Int) { hits.set("h", v) return 7 }
    on seen() { return hits.get("h") ?? 0 }
}
skeleton A {
    face {
        signal go() -> Int
    }
}
flesh A {
    on go() { let r = thelp(1)
 return 1 }
}
cell test T {
    on thelp(v: Int) { return B.bump(5) }
    rules {
        let r = try { A.go() }
        assert B.seen() == 0
    }
}
