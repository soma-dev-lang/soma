cell type P { variants { P { a: Int, b: Int } } }
cell A {
    memory { c: Map<String, Int>  invariant c >= 0 }
    on w(k: String, n: Int) {
        require (P { a: 1, b: 1 }).a + 0 >= 0 else X
        c.set(k, (P { a: n, b: 1 }).a + 0)
        return 1 }
    on probe() { let r = try { w("k", 0 - 5) }
        return r.kind ?? "ok" }
}
cell test T { rules { assert A.probe() == "invariant" } }
