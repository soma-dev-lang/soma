cell B {
    memory { hits: Map<String, Int> }
    on bump(v: Int) { hits.set("h", v) return 7 }
    on seen() { return hits.get("h") ?? 0 }
}
cell type kk {
    on khelp(v: Int) { return B.bump(5) }
}
skeleton A {
    face {
        signal go() -> Int
    }
}
flesh A {
    on go() { let s = "{khelp(1)}"
 return 1 }
}
cell test T {
    rules {
        let r = try { A.go() }
        assert B.seen() == 0
    }
}
