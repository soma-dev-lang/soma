skeleton A {
    memory { s: Map<String, Int> [persistent] }
    face {
        signal go(id: String) -> Int     writes s  calls B.apply
    }
}
skeleton B {
    memory { s: Map<String, Int> [persistent] }
    face {
        signal apply(f: Any) -> Int      // no clause: pure
        signal peek(id: String) -> Int   reads s
    }
}
flesh A {
    on go(id) { let r = map("keys", "j")  let m = map(r.keys, x => s.set(x, 7))  return B.apply(m.get("j") ?? (m.values)[0]) }
}
flesh B {
    on apply(f) { let r = f("j")  return 1 }
    on peek(id) { return s.get(id) ?? 0 }
}
cell test T {
    rules {
        assert A.go("k") == 1
        assert B.peek("j") == 7      // B's slot was written under a pure signal of B
    }
}
