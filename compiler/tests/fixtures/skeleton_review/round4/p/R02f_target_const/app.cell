skeleton Q {
    const X = "x"
    state fl {
        initial: a
        a -> b
        a -> x
        a -> X
    }
    face {
        signal st(id: String) -> String   reads fl
        signal ab(id: String) -> Int      moves a -> b
        signal mv(id: String) -> Int      moves a -> X  calls ab
    }
}
flesh Q {
    on st(id) { return get_status(id) ?? "a" }
    on ab(id) { transition(id, "a", "b")  return 1 }
    on mv(id) {
        transition(id, "a", X)  return 1
    }
}
cell test T {
    rules {
        assert Q.mv("k") == 1
    }
}
