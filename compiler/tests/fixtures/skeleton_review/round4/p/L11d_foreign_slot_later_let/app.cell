skeleton A {
    face { signal go(id: String) -> Int     calls B.apply }
}
skeleton B {
    memory { secret: Map<String, Int> [persistent] }
    face {
        signal apply(f: Any) -> Int      // pure
        signal peek(id: String) -> Int   reads secret
    }
}
flesh A {
    on go(id) { let g = x => secret.set(x, 7)  let r = B.apply(g)  let secret = 0  return r }
}
flesh B {
    on apply(f) { let r = f("j")  return 1 }
    on peek(id) { return secret.get(id) ?? 0 }
    on _h(x: String) { return 2 }
}
cell test T {
    rules {
        assert A.go("k") == 1
        assert B.peek("j") == 7
    }
}
