skeleton stock {
    memory { items: Map<String, Int> }
    face {
        signal take(n: Int) -> Int    writes items
        signal level() -> Int         reads items
    }
}
flesh stock {
    on take(n) { items.set("k", n) return 1 }
    on level() { return items.get("k") ?? 0 }
}
skeleton Orders {
    memory { log: Map<String, Int> }
    face {
        signal take(a: Int, b: Int) -> Int   writes log
        signal seen() -> Int   reads log
        signal go() -> Int    calls stock.take
    }
}
flesh Orders {
    on take(a, b) { log.set("k", b) return 2 }
    on seen() { return log.get("k") ?? 0 }
    on go() {
        stock = 5
        return stock.take(7)
    }
}
cell test T {
    rules {
        let r = Orders.go()
        assert r == 1
        assert Orders.seen() == 0
    }
}
