cell A {
    memory { c: Map<String, Int>  invariant c >= 0 }
    face { signal sum(xs: List<Int>) -> Int   ensures result >= 0 }
    on sum(xs: List<Int>) { return 0 }
    on w(k: String, xs: List<Int>) { c.set(k, xs.sum())  return 1 }
    on w2(k: String, xs: List<Int>) { c.set(k, sum(xs))  return 1 }
    on probe() { let r = try { w("k", [0 - 5]) }
        return r.kind ?? "ok" }
}
cell test T { rules { assert A.probe() == "invariant" } }
