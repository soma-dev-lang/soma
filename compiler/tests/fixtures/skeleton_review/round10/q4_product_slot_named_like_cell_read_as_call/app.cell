cell Visit {
    state v {
        initial: waiting
        waiting -> open
        open -> done
    }
    on set(id: String, n: Int) { transition(id, "waiting", "open")  return "open" }
    on close_visit(id: String) { transition(id, "open", "done")  return "done" }
    on status(id: String) { return get_status(id) ?? "waiting" }
}
cell Desk {
    memory { Visit: Map<String, Int> }
    state d {
        initial: none
        none -> requested
    }
    on vs(id: String) { return delegate("Visit", "status", id) }
    on st(id: String) { return get_status(id) ?? "none" }
    on go(id: String) {
        Visit.set(id, 1)
        transition(id, "none", "requested")
        return 1
    }
}
cell test T {
    rules {
        let r = try { Desk.go("k") }
        assert Desk.st("k") == "requested"
        assert Desk.vs("k") == "waiting"
    }
}
