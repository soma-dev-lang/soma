skeleton stock {
    memory { items: Map<String, Int> }
    face {
        signal take(n: Int) -> Int    writes items
        signal level() -> Int         reads items
    }
}
flesh stock {
    on take(n) { items.set("k", n) return 1 }
    on level() { return items.get("k") ?? 0 }
}
skeleton Orders {
    memory { log: Map<String, Int> }
    face {
        signal take(a: Any, b: Int) -> Int   writes log
        signal seen() -> Int   reads log
        signal go(stock: Int) -> Int    calls take
        signal go2() -> Int    calls stock.take
    }
}
flesh Orders {
    on take(a, b) { log.set("k", b) return 2 }
    on seen() { return log.get("k") ?? 0 }
    on go(stock) { return stock.take(7) }
    on go2() { return stock.take(8) }
}
cell test T {
    rules {
        assert Orders.go(5) == 2
        assert Orders.seen() == 7
        assert Orders.go2() == 1
        assert stock.level() == 8
    }
}
