cell Visit {
    state v {
        initial: waiting
        waiting -> open
        open -> done
        done -> open
    }
    on open_visit(id: String) { transition(id, "waiting", "open")  return "open" }
    on close_visit(id: String) { transition(id, "open", "done")  return "done" }
    on status(id: String) { return get_status(id) ?? "waiting" }
}
cell Desk {
    state d {
        initial: none
        none -> requested
    }
    on st(id: String) { return get_status(id) ?? "none" }
    on go(id: String) {
        let k = id
        require Visit.status(id) == "open" else No
        let r = [if true { k = "other"
            1 } else { 2 }, transition(k, "none", "requested")]
        return 1
    }
}
cell test T {
    rules {
        let a = Visit.open_visit("k")
        let r = try { Desk.go("k") }
        assert Desk.st("other") == "requested"
        assert Visit.status("other") == "waiting"
    }
}
