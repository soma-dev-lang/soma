cell A {
    state m {
        initial: x
        x -> y { guard { o.has_state() == false } }
    }
    on go(k: String, o: String) { 
 require o.has_state() == false else B
 transition(o, "x", "y")
 transition(k, "x", "y") return 1 }
    on probe() { let r = try { go("k", "o") }
        return r.kind ?? "ok" }
}
cell test T { rules { assert A.probe() == "guard_failed" } }
