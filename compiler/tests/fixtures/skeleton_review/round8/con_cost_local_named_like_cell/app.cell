cell agent A {
    memory { c: Map<String, Int> }
    cost { tokens: 100 }
    on run() { let a = think("q", map("max_tokens", 100))
 let B = 1
 let z = B.spend()
 return tokens_used() }
 on spend(x: Int) { let a = think("q", map("max_tokens", 100))
 return 1 }
}
cell B { on z() { return 1 } }
cell test T { rules { mock think ""
 mock think ""
 mock think ""
 assert A.run() <= 100 } }
