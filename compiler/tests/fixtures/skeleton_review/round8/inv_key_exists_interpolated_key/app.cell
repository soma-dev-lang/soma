// "The key exists" (so the set does not grow the slot) compares key TEXTS; what a string key interpolates is ignored:
// `i` is reassigned between the require and the set (variant: "u{next_id()}" on both lines).
cell A {
    memory { m: Map<String, Int>  invariant size <= 1 }
    on seed() { require len(m) < 1 else Full
  m.set("u1", 1) return 1 }
    on w(x: Int) { let i = 1
  require m.get("u{i}") != () else Missing
  i = 2
  m.set("u{i}", x) return 1 }
    on probe() { seed()
 let r = try { w(5) }
 print(r)
 return r.kind ?? "ok" }
}
cell test T { rules { assert A.probe() == "invariant" } }
