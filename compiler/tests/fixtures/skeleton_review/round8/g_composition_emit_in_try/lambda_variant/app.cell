cell Outer {
    interior {
        cell Driver {
            face { signal go(id: String) }
            on go(id: String) { return 1 }
        }
        cell Worker {
            face { await go(id: String) }
            on go(id: String) { print("worker got {id}")
               let r = [1].map(z => { emit lost(id)
 1 })
               print("after")
               return 1 }
        }
    }
    runtime { signal go("k") }
    on run() { return 1 }
}
