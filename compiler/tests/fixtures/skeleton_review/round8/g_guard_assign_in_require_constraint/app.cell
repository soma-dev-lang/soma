cell A {
    memory { log: Map<String, Int> }
    state m {
        initial: x
        x -> y { guard { amount > 0 } }
        y -> x
    }
    on ev(d: Any) { return 1 }
    on go(k: String, amount: Int) {
 require amount > 0 else B
 require len(try { amount = 0 - 5 }) >= 0 else Z
 transition(k, "x", "y")
 return 1 }
    on probe() { let r = try { go("k", 5) }
        return r.kind ?? "ok" }
}
cell test T { rules { assert A.probe() == "guard_failed" } }
