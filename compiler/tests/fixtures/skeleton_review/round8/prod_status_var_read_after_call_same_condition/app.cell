cell Visit {
    state v {
        initial: waiting
        waiting -> open
        open -> done
    }
    on open_visit(id: String) { transition(id, "waiting", "open")  return "open" }
    on close_visit(id: String) { transition(id, "open", "done")  return "done" }
    on status(id: String) { return get_status(id) ?? "waiting" }

}
cell Desk {
    state d {
        initial: none
        none -> requested
    }
    on st(id: String) { return get_status(id) ?? "none" }
    on request_lab(id: String) {
        let s = Visit.status(id)
        if Visit.close_visit(id) == "done" && s == "open" {
        transition(id, "none", "requested")
        return "requested"
        }
        return "no"
    }
}
cell test T {
    rules {
        assert Visit.open_visit("k") == "open"
        assert Desk.request_lab("k") == "requested"
        assert Desk.st("k") == "requested"
        assert Visit.status("k") != "open"
    }
}
