skeleton A {
    face { signal go(id: String) -> Int   calls B.apply }
}
skeleton B {
    memory { s: Map<String, Int> [persistent] }
    face {
        signal apply(f: Any) -> Int       // no clause: pure
        signal w(id: String) -> Int       writes s
        signal peek(id: String) -> Int    reads s
    }
}
flesh A {
    on go(id) { return B.apply(x => _h(x)) }   // check reads `_h` as A._h (pure)
    on _h(x: String) { return 1 }
}
flesh B {
    on apply(f) { let r = f("k")  return 1 }
    on w(id) { return _h(id) }
    on _h(x: String) { s.set(x, 7)  return 1 }   // …the run calls B._h: private, writes B.s
    on peek(id) { return s.get(id) ?? 0 }
}
cell test T {
    rules {
        assert A.go("k") == 1
        assert B.peek("k") == 7
    }
}
