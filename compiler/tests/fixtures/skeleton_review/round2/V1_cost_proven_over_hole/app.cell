skeleton agent Boss {
    cost { tokens: 500 }
    state job { initial: idle  idle -> done }
    face {
        signal run(q: String) -> String  calls think  moves idle -> done
    }
}
flesh Boss {
    on run(q) {
        let out = think("a {q}", map("max_tokens", 5000))
        transition(q, "idle", "done")
        return out
    }
}
