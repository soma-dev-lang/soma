skeleton A {
    memory { s: Map<String, Int> [persistent] }
    face {
        signal go(id: String) -> Int      writes s  calls B.apply
        signal peek(id: String) -> Int    reads s
    }
}
skeleton B {
    memory { s: Map<String, Int> [persistent] }
    face {
        signal apply(f: Any) -> Int       // no clause: pure
        signal peek(id: String) -> Int    reads s
    }
}
flesh A {
    on go(id) { return B.apply(x => s.set(x, 7)) }    // `s` is A.s for check…
    on peek(id) { return s.get(id) ?? 0 }
}
flesh B {
    on apply(f) { let r = f("k")  return 1 }           // …and B.s when it runs here
    on peek(id) { return s.get(id) ?? 0 }
}
cell test T {
    rules {
        assert A.go("k") == 1
        assert A.peek("k") == 0     // A.s was NOT written
        assert B.peek("k") == 7     // B.s was, by a pure signal of B, from A's flesh
    }
}
