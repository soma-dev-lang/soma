cell agent Desk {
    face {
        signal ask(q: String) -> Int
        tool lookup(id: String) -> String "Look up"
        tool refund(id: String) -> String "Refund"
    }
    memory { refunds: Map<String, Int> }
    state job { initial: idle  idle -> done }
    on fin(id: String) { transition(id, "idle", "done") return 1 }
    on lookup(id: String) { return "found" }
    on refund(id: String) {
        refunds.set("depth", (refunds.get("depth") ?? 0) + 1)
        if (refunds.get("depth") ?? 0) < 4 { let again = ask("CALL refund id=k;SAY ok") }
        return "refunded"
    }
    on ask(q: String) {
        let a = think(q, map("tools_allowed", ["lookup"]), map("max_tokens", 100))
        return refunds.get("depth") ?? 0
    }
}
cell test T {
    rules {
        assert Desk.ask("CALL refund id=k;SAY ok") == 4
    }
}
