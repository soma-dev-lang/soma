skeleton Visit {
    state v {
        initial: waiting
        waiting -> open
        open -> closing
        closing -> done
    }
    face {
        signal open_visit(id: String) -> String   moves waiting -> open
        signal step(id: String) -> String         moves open -> closing, closing -> done
        signal status(id: String) -> String       reads v
    }
}
flesh Visit {
    on open_visit(id) { transition(id, "waiting", "open")  return "open" }
    on step(id) {
        if get_status(id) == "open" { transition(id, "open", "closing") return "closing" }
        transition(id, "closing", "done")
        return "done"
    }
    on status(id) { return get_status(id) ?? "waiting" }
}
skeleton Desk {
    state d {
        initial: none
        none -> requested
    }
    face {
        signal st(id: String) -> String            reads d
        signal request_lab(id: String) -> String   moves none -> requested   calls Visit.status, prepare
        signal prepare(id: String) -> Int          calls Visit.step
    }
}
flesh Desk {
    on st(id) { return get_status(id) ?? "none" }
    on request_lab(id) {
        require Visit.status(id) == "open" else NotOpen
        let n = prepare(id)
        transition(id, "none", "requested")
        return "requested"
    }
    on prepare(id) {
        Visit.step(id)
        Visit.step(id)
        return 2
    }
}
cell test T {
    rules {
        assert Visit.open_visit("k") == "open"
        assert Desk.request_lab("k") == "requested"
        assert Desk.st("k") == "requested"
        assert Visit.status("k") == "done"
    }
}
