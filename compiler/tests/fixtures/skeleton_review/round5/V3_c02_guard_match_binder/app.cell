skeleton Approval {
    memory { m: Map<String, Int> [persistent] }
    state appr {
        initial: pending
        pending -> signed_off
        pending -> refused
    }
    face {
        signal sign(id: String) -> Int       moves pending -> signed_off 
        signal refuse(id: String) -> Int     moves pending -> refused
        signal status(id: String) -> String  reads appr
        signal approved(id: String) -> Bool   reads appr
    }
}
skeleton Pay {
    memory { log: Map<String, Int> [persistent] }
    state pay {
        initial: due
        due -> paid
        due -> void
    }
    face {
        signal pay(id: String) -> Int        moves due -> paid   calls Approval.approved
        signal cancel(id: String) -> Int     moves due -> void
        signal pst(id: String) -> String     reads pay
        
    }
}
flesh Approval {
    on sign(id) { transition(id, "pending", "signed_off")  return 1 }
    on refuse(id) { transition(id, "pending", "refused")  return 1 }
    on status(id) { return get_status(id) ?? "pending" }
    on approved(id) { return get_status(id) == "signed_off" }
}
flesh Pay {
    on pay(id) { let r = match "vip" { id -> { require Approval.approved(id) else No "x"  1 } }  transition(id, "due", "paid")  return 1 }
    on cancel(id) { transition(id, "due", "void")  return 1 }
    on pst(id) { return get_status(id) ?? "due" }
    
}
cell test T {
    rules {
        assert Approval.sign("vip") == 1
        assert Pay.pay("k") == 1
        assert Pay.pst("k") == "paid"
        assert Approval.status("k") != "signed_off"   // paid, never signed off
    }
}
