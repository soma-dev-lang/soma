cell type Lot { variants { Lot { sku: String, qty: Int } } }
cell type Receipt { variants { Paid { id: String, cents: Int }  Refused(String) } }
skeleton Depot {
    memory { lots: Map<String, Lot> [persistent] }
    face {
        signal add(id: String, sku: String, qty: Int) -> Lot   writes lots  emits low_stock
        signal of_sku(sku: String) -> List<String>   reads lots
        signal total(sku: String) -> Int   reads lots
        signal pay(id: String, cents: Int) -> Receipt
        signal low_stock(sku: String, qty: Int)
        signal words(s: String) -> String   calls pay
    }
}
flesh Depot {
    on add(id, sku, qty) {
        let lot = Lot { sku: sku, qty: qty }
        lots.set(id, lot)
        if qty < 5 { emit low_stock(sku, qty) }
        return lot
    }
    on of_sku(sku) {
        let mine = lots.entries.filter(e => e.value.sku == sku)
        let sorted = mine.sort_by(e => e.value.qty)
        return sorted.map(e => e.key)
    }
    on total(sku) {
        let t = 0
        for l in lots.values { if l.sku == sku { t = t + l.qty } }
        let one = lots.get("none")
        if one == () { return t }
        return t + one.qty
    }
    on pay(id, cents) {
        if cents <= 0 { return Refused("nothing to pay") }
        return Paid { id: id, cents: cents }
    }
    on low_stock(sku, qty) { return () }
    on words(s) {
        let shown = match pay("a", 5) {
            Paid { id, cents } -> "{id}:{cents}"
            Refused(why) -> why
        }
        let a = starts_with(s, "ab")
        let b = ends_with(s, "cd")
        let c = substring(s, 1, 3)
        return "{a} {b} {c} {shown}"
    }
}
skeleton Shop {
    memory {
        stock: Map<String, Int> [persistent]
        tags: List<String> [persistent]
        invariant stock >= 0
    }
    state order {
        initial: open
        open -> paid
        open -> void
    }
    face {
        signal demo(sku: String, n: Int) -> Map
            requires n >= 1
            writes stock, tags
            moves open -> paid
            calls level, Clock.stamp
        signal level(sku: String) -> Int   reads stock
        signal kinds(x: Int) -> String
    }
}
skeleton Clock {
    face { signal stamp(t: Int) -> String }
}
flesh Clock { on stamp(t) { return "t={t}" } }
flesh Shop {
    on level(sku) { return stock.get(sku) ?? 0 }
    on kinds(x) {
        let label = match x {
            0 -> "zero"
            1 || 2 -> "small"
            _ -> "big"
        }
        let half = idiv(x, 2)
        let ratio = x / 2
        let parts = ["a", "b"]
        parts.push("c")
        let both = parts ++ ["d"]
        let m = map("k", 1, "label", label)
        let total = 0
        for i in range(0, 3) { total = total + i }
        let w = 0
        while w < 2 { w = w + 1 }
        let size = if x > 5 { "L" } else { "S" }
        let r = try { _must(x) }
        if r.error != () { return "refused {r.kind}: {r.detail}" }
        let joined = join(parts, ",")
        return "{label} {half} {ratio} {len(both)} {m.k} {total} {w} {size} {joined} {r.value}"
    }
    on _must(x: Int) {
        require x != 7 else Unlucky "seven is refused"
        if x == 8 { fail("Eight", "so is eight") }
        return x * 2
    }
    on demo(sku, n) {
        let have = level(sku)
        stock.set(sku, have + n)
        tags.push(sku)
        let before = get_status(sku) ?? "open"
        transition(sku, "open", "paid")
        return map("ok", true, "have", stock.get(sku) ?? 0, "was", before, "now", get_status(sku), "stamp", Clock.stamp(n), "has", stock.has(sku), "n", tags.size, "keys", stock.keys)
    }
}
cell test T {
    rules {
        assert kinds(1) == "small 0 0.5 4 1 3 2 S a,b,c 2"
        assert kinds(7) == "refused Unlucky: seven is refused"
        assert kinds(8) == "refused Eight: so is eight"
        assert demo("pen", 2).have == 2
        assert_fails demo("pen", 0)
        assert_fails demo("pen", 1)
    
        assert Depot.add("l1", "x", 9).qty == 9
        assert Depot.add("l2", "x", 2).sku == "x"
        assert Depot.of_sku("x") == ["l2", "l1"]
        assert Depot.total("x") == 11
        assert Depot.words("abcd") == "true true bc a:5"
    }
}
