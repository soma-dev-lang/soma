cell Tickets {
    memory {
        titles: Map<String, String> [persistent]
    }
    state ticket {
        initial: open
        open -> resolved
    }
    on open_ticket(id: String, title: String) {
        titles.set(id, title)
        return id
    }
    on resolve(id: String) {
        transition(id, "resolved")
        return get_status(id)
    }
}
