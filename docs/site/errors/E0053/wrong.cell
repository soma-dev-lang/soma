cell Orders {
    memory {
        shipped_count: Map<String, Int> [persistent]
    }
    state order {
        initial: paid
        paid -> shipped {
            effect {
                shipped_count.set("all", (shipped_count.get("all") ?? 0) + 1)
            }
        }
    }
    on ship(id: String) {
        transition(id, "shipped")
        return id
    }
}
