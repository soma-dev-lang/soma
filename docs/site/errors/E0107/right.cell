cell Orders {
    face {
        signal place(id: String, cents: Int) -> Int
        signal total_of(id: String) -> Int
    }
    memory { totals: Map<String, Int> [persistent] }
    on place(id: String, cents: Int) {
        totals.set(id, cents)
        return totals.size
    }
    on total_of(id: String) { return totals.get(id) ?? 0 }
}

cell Refunds {
    face { signal refund(id: String, cents: Int) -> Int }
    memory { totals: Map<String, Int> [persistent] }
    on refund(id: String, cents: Int) {
        totals.set(id, cents)
        return totals.size
    }
}

cell test OrderTests {
    rules {
        let n = place("o1", 2500)
        assert total_of("o1") == 2500
    }
}
