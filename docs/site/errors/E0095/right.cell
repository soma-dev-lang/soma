cell Cart {
    face {
        signal total(prices: List<Int>) -> Int
    }
    on total(prices: List<Int>) {
        return sum(prices)
    }
}

cell test CartTests {
    on _totals_add_up() {
        return total([250, 100]) == 350 && total([]) == 0
    }
    rules {
        assert _totals_add_up()
    }
}
