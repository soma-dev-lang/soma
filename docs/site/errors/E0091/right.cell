cell Inventory {
    face {
        signal stock_of(sku: String) -> Int
        signal restock(sku: String, qty: Int) -> Int
    }
    memory {
        stock: Map<String, Int> [persistent]
    }
    on stock_of(sku: String) {
        let n = stock.get(sku)
        if n == () { return 0 }
        return n
    }
    on restock(sku: String, qty: Int) {
        let n = (stock.get(sku) ?? 0) + qty
        stock.set(sku, n)
        return n
    }
}
