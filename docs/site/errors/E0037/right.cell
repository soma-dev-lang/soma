cell Shop {
    interior {
        cell Orders {
            face {
                signal order_placed(order_id: String, cents: Int)
            }
            on order_placed(order_id: String, cents: Int) {
                print("order {order_id}: {cents} cents")
            }
        }
    }
    runtime {
        signal order_placed("ord-1", 4999)
    }
}
